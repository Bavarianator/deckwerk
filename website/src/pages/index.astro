  .flyout { position: absolute; top: calc(100% + 8px); left: 0; z-index: 6; width: 320px; padding: 8px; display: grid; background: var(--panel); border: 1px solid var(--border-strong); border-radius: 12px; box-shadow: var(--shadow-float); }
