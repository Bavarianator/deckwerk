      --panel-2: #181a1f;
      --border: #23262d;
      --border-strong: #30343c;
      --text: #e6e8ec;
      --muted: #8f95a1;
      --accent: #7a86ff;
      --accent-hover: #8d97ff;
      --accent-soft: rgb(122 134 255 / 0.14);
      --on-accent: #0b0c10;
      --shadow-slide: 0 0 0 1px rgb(255 255 255 / 0.04), 0 24px 60px -20px rgb(0 0 0 / 0.7);
      --shadow-float: 0 0 0 1px var(--border-strong), 0 24px 60px -12px rgb(0 0 0 / 0.6);
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; scroll-padding-top: 80px; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  img, picture { display: block; max-width: 100%; height: auto; }
  a { color: var(--accent); text-underline-offset: 3px; }
  a:hover { color: var(--accent-hover); }
  button { font: inherit; color: inherit; }
  h1, h2, h3 { margin: 0; font-weight: 650; text-wrap: balance; }
  h1 { font-size: clamp(2.75rem, 6vw, 4.25rem); line-height: 1.02; letter-spacing: -0.04em; }
  h2 { font-size: clamp(1.75rem, 3.6vw, 2.6rem); line-height: 1.12; letter-spacing: -0.03em; }
  h3 { font-size: 1.05rem; line-height: 1.3; letter-spacing: -0.01em; }
  p, dl, dd, figure, ol, ul { margin: 0; }
  code, kbd, pre { font-family: var(--mono); font-size: 0.86em; }
  :not(pre) > code, kbd { background: var(--panel-2); border: 1px solid var(--border); border-radius: 5px; padding: 0.05em 0.35em; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  ::selection { background: var(--accent-soft); }

  .wrap { width: min(100% - 32px, var(--wrap)); margin-inline: auto; }
  /* Grid-Spalten sonst so breit wie der längste Befehl (nowrap) → seitliches Scrollen */
  .hero > *, .zwei > *, .plattformen > *, .spieler > *, .galerie > * { min-width: 0; }
