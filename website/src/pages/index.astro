---
import '@fontsource-variable/inter'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { statSync } from 'node:fs'
import { join } from 'node:path'
import data from '../assets/folien/folien.json'

// Echte Renderings aus scripts/folien.mjs; Titel, Notizen und Briefing stehen in folien.json
type Folie = { title: string; layout: string; theme: string; notes: string }
type Deck = { title: string; brief: { audience?: string; goal?: string; tone?: string }; theme: string; slides: string[]; dl: string[] }
const bilder = import.meta.glob<{ default: ImageMetadata }>('../assets/folien/*.webp', { eager: true })
const folien = data.folien as Record<string, Folie>
const decks = data.decks as Record<string, Deck>
const THEMES: Record<string, string> = { beratung: 'Beratung', keynote: 'Keynote', schweiz: 'Schweiz', redaktion: 'Redaktion', zen: 'Zen' }
const bild = (id: string, sizes: string, widths = [480, 960, 1600]) => ({
  src: bilder[`../assets/folien/${id}.webp`].default,
  alt: folien[id].title ? `Folie „${folien[id].title}“` : `Folie im Layout ${folien[id].layout}`,
  sizes,
  widths,
  format: 'webp' as const,
})

// GitHub-Daten beim Build (Pages-Workflow baut täglich neu); ohne Netz bleiben die Stellen weg
const gh = async (path: string) => {
  try {
    const token = process.env.GITHUB_TOKEN
    const r = await fetch(`https://api.github.com/repos/Bavarianator/${path}`, { headers: token ? { authorization: `Bearer ${token}` } : {} })
    return r.ok ? await r.json() : null
  } catch {
    return null
  }
}
const [info, releases] = await Promise.all([gh('deckwerk'), gh('deckwerk/releases?per_page=3')])
const datum = (iso: string) => new Date(iso).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
const absatz = (md = '') => (md.split(/\n\s*\n/).find((p) => p.trim() && !/^\s*(#|```|-)/.test(p)) ?? '').replace(/\*\*|`/g, '').trim()
const neu = ((releases ?? []) as any[]).map((r) => ({ name: r.name || r.tag_name, url: r.html_url, datum: datum(r.published_at), text: absatz(r.body) }))
const appimage = releases?.[0]?.assets?.find((a: any) => a.name === 'Deckwerk-x86_64.AppImage')
const version = releases?.[0] ? `${releases[0].tag_name.replace(/^v/, '')} vom ${datum(releases[0].published_at)}` : ''
const sterne: number = info?.stargazers_count ?? 0
const mb = (bytes: number) => `${(bytes / 1e6).toLocaleString('de-DE', { maximumFractionDigits: bytes < 1e7 ? 1 : 0 })} MB`
const groesse = (f: string) => { try { return mb(statSync(join(process.cwd(), 'public', f)).size) } catch { return '' } }

const REPO = 'https://github.com/Bavarianator/deckwerk'
const MAC_REPO = 'https://github.com/Bavarianator/deckwerk-macos'
const APPIMAGE = `${REPO}/releases/latest/download/Deckwerk-x86_64.AppImage`
const DMG = `${MAC_REPO}/releases/download/latest/Deckwerk-arm64.dmg` // laufender Mac-Build, wie install.sh ohne Version
const INSTALL = 'curl -fsSL https://raw.githubusercontent.com/Bavarianator/deckwerk/master/scripts/install.sh | sh'
const INSTALL_MAC = 'curl -fsSL https://raw.githubusercontent.com/Bavarianator/deckwerk-macos/main/install.sh | sh'
const UNINSTALL = 'curl -fsSL https://raw.githubusercontent.com/Bavarianator/deckwerk/master/scripts/uninstall.sh | sh'
const MCP = 'claude mcp add -s user deckwerk -- ~/deckwerk/scripts/deckwerk.sh --mcp'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const url = new URL(base, Astro.site)
const beispiel = decks.strategie.dl.find((f) => f.endsWith('.pptx'))

const MENUS: { name: string; links: [href: string, label: string, hint: string][] }[] = [
  {
    name: 'Entdecken',
    links: [
      ['#so-gehts', 'So geht’s', 'In drei Schritten zur fertigen Präsentation'],
      ['#wofuer', 'Wofür?', 'Bericht, Pitch, Strategie, Antrag'],
      ['#abnehmen', 'Was Deckwerk dir abnimmt', 'Geschichte, Gestaltung, Kontrolle'],
      ['#kosten', 'Was es kostet', 'Die App ist kostenlos'],
      ['#daten', 'Deine Daten', 'Was deinen Rechner verlässt'],
      ['#faq', 'Fragen', 'Antworten in Klartext'],
    ],
  },
  {
    name: 'Ausprobieren',
    links: [
      ['#demo', 'Präsentationen durchklicken', 'Vier fertige Beispiele im Browser'],
      ['#looks', 'Stil wechseln', 'Ein Inhalt in fünf Looks'],
      ['#formate', 'Formate', 'Präsentation, Post, Story, Handout'],
      ...(beispiel ? [[`${base}${beispiel}`, 'Beispiel als PowerPoint', `„${decks.strategie.title}“, ${groesse(beispiel)}`] as [string, string, string]] : []),
      ['#laden', 'Kostenlos laden', 'Für Mac und Linux'],
    ],
  },
  {
    name: 'GitHub',
    links: [
      [REPO, 'Quellcode', sterne ? `Repository auf GitHub · ★ ${sterne}` : 'Repository auf GitHub'],
      [`${REPO}/releases`, 'Versionen', version ? `Aktuell ${version}` : 'Alle Releases'],
      ['#technik', 'Unter der Haube', 'Prüfung, Agenten, Neuigkeiten'],
      [`${REPO}/issues/new`, 'Fehler melden', 'Issue auf GitHub öffnen'],
      [`${REPO}#entwicklung`, 'Mitentwickeln', 'Bauen, testen, Layouts ergänzen'],
      [MAC_REPO, 'macOS-Fassung', 'Für Macs mit Apple Silicon'],
      [`${REPO}/blob/master/LICENSE`, 'Lizenz', 'AGPL-3.0, frei und offen'],
    ],
  },
]

// Hero: ein Satz wird getippt, dann legen sich echte Folien des passenden Beispiel-Decks aufeinander, die Titelfolie zuletzt obenauf
const SZENEN = [
  { satz: 'Quartalsbericht für die Geschäftsführung: Wir liegen 9 % über Plan und brauchen zwei neue Stellen.', deck: 'quartal', folien: [4, 3, 1] },
  { satz: 'Präsentation für unsere Gesellschafter: drei neue Standorte für unser Café.', deck: 'foto', folien: [3, 2, 1] },
  { satz: 'Pitch für einen Schulbuchverlag: Unser Rechtschreib-Tool soll an 20 Schulen starten.', deck: 'pitch', folien: [8, 5, 1] },
]
const band = ['strategie-1', 'pitch-5', 'foto-2', 'quartal-4', 'strategie-4', 'pitch-11', 'foto-7', 'quartal-3', 'pitch-8', 'strategie-5', 'foto-6', 'pitch-1']
const WOFUER = [
  ['quartal-3', 'Bericht für den Chef', 'Zahlen, die auf einen Blick sitzen, und eine klare Bitte am Ende.'],
  ['pitch-8', 'Pitch für Partner', 'Problem, Lösung, Beweis: eine Geschichte, die überzeugt.'],
  ['strategie-4', 'Strategie für den Führungskreis', 'Große Gedanken ruhig und klar auf den Punkt gebracht.'],
  ['foto-6', 'Antrag bei Bank oder Gesellschaftern', 'Mit Fotos, Kennzahlen und einer Entscheidung, um die du bittest.'],
] as const
const formate = [
  ['16:9', 'Präsentation', 'format-16-9-1'],
  ['1:1', 'Instagram-Post', 'format-1-1-1'],
  ['9:16', 'Story', 'format-9-16-1'],
  ['A4', 'Handout', 'format-a4-1'],
]
const BRIEF = { audience: 'Für wen', goal: 'Ziel', tone: 'Ton' } as const
const beschreibung = 'Sag in einem Satz, was du zeigen willst: Deckwerk schreibt die Geschichte, gestaltet die Folien, prüft jede einzelne und liefert eine PowerPoint, die du weiterbearbeiten kannst. Kostenlos für Mac und Linux.'
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deckwerk – Präsentationen aus einem Satz</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f2f2f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0d10" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content="Deckwerk – Präsentationen aus einem Satz" />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL('og.jpg', url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="kopf">
      <div class="wrap kopf-in">
        <a class="marke" href={base} aria-label="Deckwerk, zum Seitenanfang">
          <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
          <span>Deckwerk</span>
        </a>
        <nav class="menue" aria-label="Hauptmenü">
          {
            MENUS.map((m) => (
              <details class="aufklapp">
                <summary>{m.name}</summary>
                <div class="flyout">
                  {m.links.map(([href, label, hint]) => (
                    <a href={href}>
                      <b>{label}</b>
                      <span>{hint}</span>
                    </a>
                  ))}
                </div>
              </details>
            ))
          }
        </nav>
        <a class="knopf klein" href="#laden"><span class="lang">Kostenlos laden</span><span class="kurz">Laden</span></a>
        <details class="aufklapp handy">
          <summary aria-label="Menü öffnen">Menü</summary>
          <div class="flyout">
            {
              MENUS.map((m) => (
                <div class="gruppe">
                  <p>{m.name}</p>
                  {m.links.map(([href, label]) => (
                    <a href={href}>
                      <b>{label}</b>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
        </details>
      </div>
    </header>

    <main id="inhalt">
      <section class="hero wrap">
        <div class="hero-text">
          <h1>Sag, was du zeigen willst. <span class="akzent">Deckwerk baut die Präsentation.</span></h1>
          <p class="lede">
            Ein Satz genügt. Deckwerk denkt sich die Geschichte aus, gestaltet jede Folie und prüft sie, bevor du sie siehst. Am
            Ende hast du eine PowerPoint-Datei, die du ganz normal weiterbearbeiten kannst.
          </p>
          <p class="aktionen">
            <a class="knopf gross" href="#laden">Kostenlos laden</a>
            <a class="knopf zweit gross" href="#demo">Beispiele ansehen</a>
          </p>
          <p class="hinweis">Für Mac und Linux · Open Source · keine Anmeldung bei uns</p>
        </div>
        <div class="buehne-hero" aria-label="Beispiel: Aus einem Satz wird eine Präsentation">
          {
            SZENEN.map((s, i) => (
              <div class:list={['szene', { fertig: i === 0 }]} data-satz={s.satz} hidden={i > 0}>
                <div class="eingabe">
                  <span class="eingabe-label">Was möchtest du zeigen?</span>
                  <p class="eingabe-text">{s.satz}</p>
                </div>
                <div class="stapel">
                  {s.folien.map((n) => (
                    <Image {...bild(`${s.deck}-${n}`, '(max-width: 980px) 80vw, 460px', [480, 960])} class="folie" loading={i === 0 ? 'eager' : 'lazy'} />
                  ))}
                </div>
                <p class="status">
                  <span>Geschichte steht</span>
                  <span>Folien gestaltet</span>
                  <span>Alles geprüft</span>
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="band" aria-label="Folien, die Deckwerk gebaut hat">
        <div class="band-in">
          {
            [0, 1].map((kopie) =>
              band.map((id) => <Image {...bild(id, '320px', [320, 640])} class="folie" aria-hidden={kopie === 1 ? 'true' : undefined} alt={kopie === 1 ? '' : bild(id, '').alt} />),
            )
          }
        </div>
        <p class="wrap band-text">Alle Folien auf dieser Seite hat Deckwerk selbst gebaut und gerendert.</p>
      </section>

      <section class="abschnitt" id="so-gehts">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">So geht’s</p>
            <h2>Drei Schritte, und du stehst vorne</h2>
          </header>
          <ol class="schritte">
            <li>
              <h3>Erzählen</h3>
              <p>Schreib in einem Satz, worum es geht und für wen. Wenn du magst, häng Material an: ein PDF, ein Word-Dokument, alte Folien oder eine Tabelle.</p>
            </li>
            <li>
              <h3>Zurücklehnen</h3>
              <p>Deckwerk überlegt sich den roten Faden, wählt für jede Folie das passende Layout, sucht Fotos und schreibt dir Notizen für den Vortrag.</p>
            </li>
            <li>
              <h3>Präsentieren</h3>
              <p>Direkt aus Deckwerk vortragen oder als PowerPoint und PDF weitergeben. Gefällt dir etwas nicht, sag es einfach: „Mach Folie 3 ruhiger.“</p>
            </li>
          </ol>
        </div>
      </section>

      <section class="abschnitt" id="demo">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Ausprobieren</p>
            <h2>Klick dich durch Präsentationen, die Deckwerk gebaut hat</h2>
            <p class="lede">
              Vier Beispiele, Folie für Folie. Daneben siehst du, für wen sie gedacht sind, und den Ablauf. Darunter steht, was du
              beim Vortrag sagen könntest – auch das schreibt Deckwerk.
            </p>
          </header>
          <div class="demo-wahl" role="group" aria-label="Beispiel wählen">
            {
              Object.entries(decks).map(([name, d], i) => (
                <button type="button" data-deck={name} aria-pressed={i === 0 ? 'true' : 'false'}>
                  {d.title}
                </button>
              ))
            }
          </div>
          {
            Object.entries(decks).map(([name, d], i) => (
              <div class="spieler" data-deck={name} hidden={i > 0}>
                <div class="spieler-haupt">
                  <div class="buehne" tabindex="0" aria-label={`${d.title}: klicken oder Pfeiltasten zum Blättern`}>
                    {d.slides.map((id, n) => (
                      <Image {...bild(id, '(max-width: 980px) 100vw, 740px')} class="folie" hidden={n > 0} loading="lazy" />
                    ))}
                  </div>
                  <div class="leiste">
                    <button type="button" data-schritt="-1" aria-label="Vorige Folie">←</button>
                    <span class="zaehler" aria-live="polite">1 / {d.slides.length}</span>
                    <button type="button" data-schritt="1" aria-label="Nächste Folie">→</button>
                    <button type="button" class="vollbild">Vollbild</button>
                    <span class="downloads">
                      {d.dl.map((f) => (
                        <a href={`${base}${f}`} download>
                          {f.endsWith('.pptx') ? 'Als PowerPoint' : 'Als PDF'} <small>{groesse(f)}</small>
                        </a>
                      ))}
                    </span>
                  </div>
                  <div class="notiz">
                    <b>Das könntest du sagen</b>
                    {d.slides.map((id, n) => <p hidden={n > 0}>{folien[id].notes || '–'}</p>)}
                  </div>
                </div>
                <aside class="storyline" aria-label="Für wen und Ablauf">
                  <dl class="briefing">
                    {Object.entries(BRIEF).map(([k, label]) => d.brief[k as keyof typeof BRIEF] && (
                      <div>
                        <dt>{label}</dt>
                        <dd>{d.brief[k as keyof typeof BRIEF]}</dd>
                      </div>
                    ))}
                    <div>
                      <dt>Stil</dt>
                      <dd>{THEMES[d.theme] ?? d.theme}</dd>
                    </div>
                  </dl>
                  <p class="storyline-titel">Ablauf – schon die Titel erzählen die Geschichte</p>
                  <ol>
                    {d.slides.map((id, n) => (
                      <li>
                        <button type="button" aria-current={n === 0 ? 'true' : undefined}>
                          {folien[id].title || folien[id].layout}
                        </button>
                      </li>
                    ))}
                  </ol>
                </aside>
              </div>
            ))
          }
        </div>
      </section>

      <section class="abschnitt" id="wofuer">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Wofür?</p>
            <h2>Für alles, wo du andere überzeugen willst</h2>
            <p class="lede">Ob Chef, Kundin, Beirat oder Bank: Deckwerk baut keine bunten Folien, sondern eine Präsentation mit klarer Aussage.</p>
          </header>
          <div class="galerie">
            {
              WOFUER.map(([id, titel, text]) => (
                <figure>
                  <Image {...bild(id, '(max-width: 760px) 100vw, 560px')} class="folie" />
                  <figcaption>
                    {titel}
                    <span>{text}</span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="abschnitt" id="abnehmen">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Was Deckwerk dir abnimmt</p>
            <h2>Die Arbeit, die sonst den Abend frisst</h2>
          </header>
          <dl class="liste">
            <div>
              <dt>Der rote Faden</dt>
              <dd>Jede Folie hat eine klare Aussage, und die Titel ergeben zusammen die Geschichte. So, wie Berater ihre Präsentationen bauen.</dd>
            </div>
            <div>
              <dt>Die Gestaltung</dt>
              <dd>29 Layouts, passende Schriften und Farben. Ruhig und aufgeräumt statt überladen. Deine Firmenfarbe kann Deckwerk übernehmen.</dd>
            </div>
            <div>
              <dt>Die Kontrolle</dt>
              <dd>Deckwerk schaut sich jede Folie an wie ein strenger Kollege: Läuft etwas über? Ist die Schrift zu klein? Steht zu viel Text drauf? Erst dann bekommst du sie zu sehen.</dd>
            </div>
            <div>
              <dt>Fotos und Diagramme</dt>
              <dd>Fotos aus deinem eigenen Ordner oder von Unsplash, auf Wunsch eigene KI-Bilder. Diagramme mit echten Zahlen, die du später noch ändern kannst.</dd>
            </div>
            <div>
              <dt>Die Notizen für den Vortrag</dt>
              <dd>Zu jeder Folie steht, was du sagen kannst. Beim Präsentieren siehst nur du sie, mit Uhr und der nächsten Folie.</dd>
            </div>
            <div>
              <dt>Das Speichern</dt>
              <dd>Jede Änderung wird sofort gesichert, frühere Stände kannst du wiederherstellen. Nichts geht verloren.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="abschnitt" id="looks">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Stil</p>
            <h2>Ein Klick, und der ganze Look ist ein anderer</h2>
            <p class="lede">Probier es aus: Dieselben drei Folien in fünf Stilen. Oder Deckwerk entwirft dir einen eigenen, passend zum Thema.</p>
          </header>
          <div class="looks">
            <div class="looks-wahl" role="radiogroup" aria-label="Stil wählen">
              {
                Object.entries(THEMES).map(([id, name], i) => (
                  <label>
                    <input type="radio" name="look" value={id} checked={i === 0} />
                    <span>{name}</span>
                  </label>
                ))
              }
            </div>
            {
              Object.keys(THEMES).map((id) => (
                <div class="look" data-look={id}>
                  {[1, 2, 3].map((n) => (
                    <Image {...bild(`look-${id}-${n}`, n === 1 ? '(max-width: 760px) 100vw, 740px' : '(max-width: 760px) 100vw, 370px')} class="folie" />
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="abschnitt" id="formate">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Formate</p>
            <h2>Aus einer Präsentation wird ein Post, eine Story oder ein Handout</h2>
            <p class="lede">Deckwerk ordnet die Folien für das neue Format neu an. Du musst nichts von Hand verschieben.</p>
          </header>
          <div class="formate">
            {
              formate.map(([name, wozu, id]) => (
                <figure>
                  <Image {...bild(id, '(max-width: 760px) 50vw, 400px')} class="folie" />
                  <figcaption>
                    <b>{name}</b> {wozu}
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="abschnitt" id="vortragen">
        <div class="wrap zwei">
          <header class="kopfzeile">
            <p class="vorzeile">Vortragen und weitergeben</p>
            <h2>Vorne stehen oder die Datei verschicken – beides geht</h2>
            <p class="lede">
              Mit einem zweiten Bildschirm sieht das Publikum die Folien und du deine Notizen, die Uhr und was als Nächstes kommt.
              {beispiel && <> Oder du schickst die Datei: <a href={`${base}${beispiel}`} download>Beispiel als PowerPoint laden</a> ({groesse(beispiel)}).</>}
            </p>
          </header>
          <dl class="liste eng">
            <div>
              <dt>PowerPoint zum Weiterbearbeiten</dt>
              <dd>Texte, Bilder und Diagramme bleiben einzeln anfassbar, Schriften und Animationen sind dabei. Dazu PDF und Bilder.</dd>
            </div>
            <div>
              <dt>Laserpointer und Stift</dt>
              <dd>Auf Tastendruck zeigen oder etwas einkreisen, das Publikum sieht es live.</dd>
            </div>
            <div>
              <dt>Handy als Fernbedienung</dt>
              <dd>QR-Code scannen, blättern und Notizen lesen. Handy und Rechner müssen im selben WLAN sein.</dd>
            </div>
            <div>
              <dt>Weiche Übergänge</dt>
              <dd>Ein Wort oder ein Foto gleitet von einer Folie zur nächsten, wie bei „Morph“ in PowerPoint.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="abschnitt" id="kosten">
        <div class="wrap zwei">
          <header class="kopfzeile">
            <p class="vorzeile">Was es kostet</p>
            <h2>Deckwerk ist kostenlos. Die KI bringst du mit.</h2>
          </header>
          <div class="text">
            <p>
              Die App kostet nichts und ist Open Source. Für das Denken nutzt Deckwerk die KI, die du vielleicht schon hast: dein Abo
              bei <b>Claude</b>, <b>ChatGPT</b> (über Codex) oder <b>Mistral</b>, oder einen eigenen API-Schlüssel von Anthropic.
            </p>
            <p>
              Beim ersten Start sucht Deckwerk von selbst, was auf deinem Rechner angemeldet ist. Du musst nur noch auswählen.
            </p>
          </div>
        </div>
      </section>

      <section class="abschnitt" id="daten">
        <div class="wrap zwei">
          <header class="kopfzeile">
            <p class="vorzeile">Deine Daten</p>
            <h2>Deine Präsentationen bleiben auf deinem Rechner</h2>
          </header>
          <div class="text">
            <p>
              Deckwerk speichert alles als Datei bei dir, nicht in einer Cloud von uns. Ein Konto bei uns gibt es nicht. An die KI geht
              nur, was sie zum Bauen braucht: dein Wunsch, der Inhalt und die Folienbilder, je nach Wahl an Anthropic, OpenAI oder
              Mistral.
            </p>
            <p>Rendern, Exportieren und das Freistellen von Fotos passieren auf deinem Rechner.</p>
          </div>
        </div>
      </section>

      <section class="abschnitt" id="faq">
        <div class="wrap zwei">
          <header class="kopfzeile">
            <p class="vorzeile">Fragen</p>
            <h2>Was Leute vorher wissen wollen</h2>
          </header>
          <div class="faq">
            <details>
              <summary>Brauche ich Technikkenntnisse?</summary>
              <p>Nein. Auf dem Mac lädst du die App wie jede andere. Unter Linux kopierst du einmal einen Befehl ins Terminal, die Anleitung steht unten. Danach redest du mit Deckwerk wie mit einem Kollegen.</p>
            </details>
            <details>
              <summary>Was, wenn mir eine Folie nicht gefällt?</summary>
              <p>Sag es einfach, zum Beispiel „Folie 4 bitte mit Foto“ oder „weniger Text“. Oder du klickst direkt auf die Folie und änderst Text, Bilder und Farben selbst, ähnlich wie in Canva.</p>
            </details>
            <details>
              <summary>Funktioniert das mit PowerPoint und Keynote?</summary>
              <p>Deckwerk speichert eine normale PowerPoint-Datei, die sich in PowerPoint, Keynote, LibreOffice oder Google Slides öffnen lässt. Getestet ist sie bisher mit LibreOffice; Diagramme sehen in PowerPoint leicht anders aus als in der Vorschau.</p>
            </details>
            <details>
              <summary>Kann ich meine Firmenfarben und Schriften nutzen?</summary>
              <p>Ja. Sag Deckwerk deine Markenfarbe, und mit „merk dir …“ hältst du Vorlieben für alle künftigen Präsentationen fest.</p>
            </details>
            <details>
              <summary>Läuft Deckwerk unter Windows?</summary>
              <p>Über WSL, das ist ein in Windows eingebautes Linux. Eine eigene Windows-Version gibt es noch nicht.</p>
            </details>
            <details>
              <summary>Brauche ich Internet?</summary>
              <p>Für die KI und die Fotosuche ja. Bearbeiten, Vortragen und Exportieren gehen auch offline.</p>
            </details>
            <details>
              <summary>Wie werde ich Deckwerk wieder los?</summary>
              <p>Unter Linux mit diesem Befehl, deine Präsentationen bleiben dabei erhalten:</p>
              <div class="befehl">
                <code>{UNINSTALL}</code>
                <button type="button" data-copy={UNINSTALL}>Kopieren</button>
              </div>
            </details>
          </div>
        </div>
      </section>

      <section class="abschnitt" id="laden">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Kostenlos laden</p>
            <h2>In zwei Minuten startklar</h2>
          </header>
          <div class="plattformen">
            <div>
              <h3>Mac (Apple Silicon, ab M1)</h3>
              <ol class="anleitung">
                <li><a class="knopf" href={DMG}>Deckwerk für Mac laden</a></li>
                <li>Die Datei öffnen und Deckwerk in „Programme“ ziehen.</li>
                <li>Beim ersten Start blockiert macOS die App, weil sie nicht von Apple geprüft ist: Systemeinstellungen → Datenschutz &amp; Sicherheit → „Trotzdem öffnen“.</li>
              </ol>
              <p class="klein">Oder im Terminal, das richtet auch die Agenten ein:</p>
              <div class="befehl">
                <code>{INSTALL_MAC}</code>
                <button type="button" data-copy={INSTALL_MAC}>Kopieren</button>
              </div>
            </div>
            <div>
              <h3>Linux (und Windows mit WSL)</h3>
              <ol class="anleitung">
                <li>Terminal öffnen, meist mit <kbd>Strg</kbd>+<kbd>Alt</kbd>+<kbd>T</kbd>.</li>
                <li>
                  Diesen Befehl kopieren, einfügen und mit Enter bestätigen:
                  <div class="befehl">
                    <code>{INSTALL}</code>
                    <button type="button" data-copy={INSTALL}>Kopieren</button>
                  </div>
                </li>
                <li>Deckwerk im Startmenü öffnen. Updates holst du mit demselben Befehl.</li>
              </ol>
              <p class="klein">
                Lieber eine einzelne Datei? <a href={APPIMAGE}>AppImage laden{appimage ? ` (${mb(appimage.size)})` : ''}</a>, braucht libfuse2.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="abschnitt technik" id="technik">
        <div class="wrap">
          <header class="kopfzeile">
            <p class="vorzeile">Unter der Haube</p>
            <h2>Für alle, die es genau wissen wollen</h2>
          </header>
          <div class="technik-raster">
            <div>
              <h3>Die Prüfung</h3>
              <p>Autofit misst jeden Textblock und stuft die Schrift herunter, bis nichts mehr überläuft. Danach prüft ein Lint Ränder, Mindestgröße, Überlappung, Textmenge und den Rhythmus des Decks. Echte Ausgabe für ein Deck mit drei Listen hintereinander:</p>
              <pre class="konsole"><code>{data.lint.length ? data.lint.join('\n') : '0 Fehler, 0 Warnungen'}</code></pre>
            </div>
            <div>
              <h3>Für Agenten</h3>
              <p>Deckwerk ist auch ein MCP-Server mit 20 Werkzeugen. Claude Code, Codex und Vibe bauen damit Decks direkt aus dem Terminal; der Installer trägt ihn samt Skill ein.</p>
              <pre class="konsole"><code>{MCP}</code></pre>
              <button type="button" data-copy={MCP}>Befehl kopieren</button>
            </div>
            <div>
              <h3>Offen</h3>
              <p>
                Quellcode unter der <a href={`${REPO}/blob/master/LICENSE`}>AGPL-3.0</a> auf <a href={REPO}>GitHub</a>. Electron und React,
                ein fester Layout-Katalog, PPTX mit nativen Objekten.{version && ` Aktuell Version ${version}.`}
              </p>
              {
                neu.length > 0 && (
                  <ol class="versionen">
                    {neu.map((r) => (
                      <li>
                        <a href={r.url}>{r.name}</a>
                        <span>{r.datum}</span>
                        <p>{r.text}</p>
                      </li>
                    ))}
                  </ol>
                )
              }
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="fuss">
      <div class="wrap fuss-in">
        <div>
          <a class="marke" href={base}>
            <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
            <span>Deckwerk</span>
          </a>
          <p>Präsentationen aus einem Satz. Kostenlos und Open Source.</p>
        </div>
        {
          MENUS.map((m) => (
            <nav aria-label={m.name}>
              <p>{m.name}</p>
              {m.links.map(([href, label]) => (
                <a href={href}>{label}</a>
              ))}
            </nav>
          ))
        }
        <p class="klein">
          Schriften unter der SIL Open Font License. Fotos in den Beispielen von Unsplash (<a href={`${REPO}/blob/master/examples/assets/CREDITS.md`}>Bildnachweise</a>).
          Diese Seite setzt keine Cookies, zählt keine Besucher und lädt nichts von Dritten.
        </p>
      </div>
    </footer>

    <script>
      const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches

      // Kopieren-Knöpfe
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]'))
        b.addEventListener('click', async () => {
          const alt = b.textContent
          try {
            await navigator.clipboard.writeText(b.dataset.copy!)
            b.textContent = 'Kopiert'
          } catch {
            b.textContent = 'Bitte von Hand kopieren'
          }
          setTimeout(() => (b.textContent = alt), 1600)
        })

      // Menüs: nur eins offen, schließen bei Klick daneben, auf einen Link oder mit Esc
      const menues = [...document.querySelectorAll<HTMLDetailsElement>('details.aufklapp')]
      for (const d of menues) d.addEventListener('toggle', () => d.open && menues.forEach((o) => o !== d && (o.open = false)))
      document.addEventListener('click', (e) => {
        const t = e.target as Element
        for (const d of menues) if (d.open && (!d.contains(t) || t.closest('a'))) d.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return
        for (const d of menues) if (d.open) (d.open = false), d.querySelector('summary')!.focus()
      })

      // Hero: Satz tippen, Folien auflegen, Status abhaken, nächste Szene. Ohne Bewegung bleibt die erste Szene fertig stehen.
      const szenen = [...document.querySelectorAll<HTMLElement>('.szene')]
      const pause = (ms: number) => new Promise((r) => setTimeout(r, ms))
      if (ruhig) szenen[0]?.classList.add('fertig')
      else
        (async () => {
          for (let i = 0; ; i = (i + 1) % szenen.length) {
            const s = szenen[i]
            const text = s.querySelector('.eingabe-text')!
            szenen.forEach((x) => (x.hidden = x !== s))
            s.classList.remove('fertig')
            for (let n = 0; n <= s.dataset.satz!.length; n++) {
              text.textContent = s.dataset.satz!.slice(0, n)
              await pause(28)
            }
            await pause(350)
            s.classList.add('fertig')
            await pause(5200)
          }
        })()

      // Live-Demo: Deck wählen, blättern per Klick, Pfeiltasten und Ablauf, Vollbild
      const wahl = [...document.querySelectorAll<HTMLButtonElement>('.demo-wahl button')]
      const spieler = [...document.querySelectorAll<HTMLElement>('.spieler')]
      for (const b of wahl)
        b.addEventListener('click', () => {
          wahl.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
          spieler.forEach((s) => (s.hidden = s.dataset.deck !== b.dataset.deck))
        })
      for (const s of spieler) {
        const buehne = s.querySelector<HTMLElement>('.buehne')!
        const bilder = [...buehne.querySelectorAll('img')]
        const notizen = [...s.querySelectorAll<HTMLElement>('.notiz p')]
        const punkte = [...s.querySelectorAll<HTMLButtonElement>('.storyline button')]
        const zaehler = s.querySelector('.zaehler')!
        let i = 0
        const zeige = (n: number) => {
          i = (n + bilder.length) % bilder.length
          bilder.forEach((f, k) => (f.hidden = k !== i))
          notizen.forEach((p, k) => (p.hidden = k !== i))
          punkte.forEach((p, k) => (k === i ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')))
          zaehler.textContent = `${i + 1} / ${bilder.length}`
          if (bilder[i + 1]) bilder[i + 1].loading = 'eager' // nächste Folie vorladen
        }
        buehne.addEventListener('click', () => zeige(i + 1))
        s.querySelectorAll<HTMLButtonElement>('[data-schritt]').forEach((b) => b.addEventListener('click', () => zeige(i + Number(b.dataset.schritt))))
        punkte.forEach((p, k) => p.addEventListener('click', () => zeige(k)))
        s.querySelector('.vollbild')!.addEventListener('click', () => buehne.requestFullscreen?.())
        s.addEventListener('keydown', (e) => {
          const schritt = { ArrowRight: 1, PageDown: 1, ArrowLeft: -1, PageUp: -1 }[e.key]
          if (!schritt) return
          e.preventDefault()
          zeige(i + schritt)
        })
      }
    </script>
  </body>
</html>

