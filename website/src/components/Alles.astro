---
// Was drin ist: eine weiße Fläche mit Zeilen wie das Panel der App; darunter der Weg für Agenten
import { MCP, REPO, base, beispiel, groesse } from '../lib/seite'

const ZEILEN: [string, string][] = [
  ['PowerPoint, die sich bearbeiten lässt', 'Texte, Bilder und Diagramme bleiben einzeln anfassbar, Schriften und Animationen sind dabei. Dazu PDF, PNG und Markdown.'],
  ['40 Layouts', 'Ruhig gestaltet nach den Regeln guter Designer statt bunter Vorlagen. Für Folien, Social-Formate und Drucksachen von Brief und Lebenslauf bis Visitenkarte.'],
  ['Serienbrief', 'Urkunden, Einladungen oder Namensschilder für eine ganze Liste: {{Name}} in den Text, CSV dazu, je Zeile ein PDF.'],
  ['Jede Folie geprüft', 'Nichts läuft über, nichts ist zu klein, nichts steht zu dicht.'],
  ['Videos schneiden', 'Shorts, Reels und kürzere Fassungen aus langen Aufnahmen, mit Untertiteln, als MP4.'],
  ['Vorne stehen', 'Du siehst Notizen, Uhr und nächste Folie, das Publikum nur die Folien. Das Handy wird zur Fernbedienung.'],
  ['Deine KI', 'Claude, ChatGPT oder Mistral, mit deinem Login oder Schlüssel.'],
  ['Lokal', 'Kein Konto, keine Cloud von uns. Deine Präsentationen liegen als Datei auf deinem Rechner.'],
  ['Kostenlos', 'Open Source unter AGPL-3.0.'],
]
---

<section class="abschnitt" id="alles">
  <div class="wrap">
    <header class="abschnitt-kopf">
      <h2>Alles, was eine Präsentation braucht.</h2>
    </header>
    <dl class="blatt panel">
      {
        ZEILEN.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    {beispiel && <p class="blatt-dl"><a class="pfeil" href={`${base}${beispiel}`} download>Beispiel-PowerPoint laden ({groesse(beispiel)})</a></p>}
  </div>
</section>

<section class="abschnitt weiss agenten" id="agenten">
  <div class="wrap agenten-in">
    <div>
      <h2>Für Agenten.</h2>
      <p class="unterzeile">Ein MCP-Server mit 27 Werkzeugen. Claude Code, Codex und Vibe bauen Decks und schneiden Videos direkt aus dem Terminal.</p>
      <a class="pfeil" href={REPO}>Quellcode auf GitHub</a>
    </div>
    <div class="terminal">
      <div class="befehl">
        <code>{MCP}</code>
        <button type="button" data-copy={MCP}>Kopieren</button>
      </div>
      <pre><span class="akzent">$</span> claude "Quartalsupdate aus zahlen.csv, 8 Folien"
<span class="terminal-leise">  create_deck · add_slides · render_overview · lint_deck
  ✓ 8 Folien geprüft · save_deck</span></pre>
    </div>
  </div>
</section>

<style is:global>
  .blatt { max-width: 860px; margin-inline: auto; padding: 8px 28px; }
  .blatt > div { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1.5rem; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .blatt > div:last-child { border-bottom: 0; }
  .blatt dt { font-weight: 600; }
  .blatt dd { color: var(--muted); }
  .blatt-dl { margin-top: 1.25rem; text-align: center; }
  @media (max-width: 760px) { .blatt { padding: 4px 20px; } .blatt > div { grid-template-columns: 1fr; gap: 0.25rem; } }

  .agenten-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .agenten .unterzeile { margin: 1rem 0 0.5rem; }
  .terminal { min-width: 0; padding: 14px; border-radius: 16px; background: var(--bg); }
  .terminal pre { margin: 0; padding: 16px 6px 4px; font-size: 0.85rem; line-height: 1.7; white-space: pre-wrap; }
  .terminal-leise { color: var(--faint); }
  @media (max-width: 860px) { .agenten-in { grid-template-columns: 1fr; } }
</style>
