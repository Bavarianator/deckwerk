---
// Datenblatt: alles Wichtige als technische Tabelle mit Haarlinien (Export, Prüfung, Vortrag, KI, Daten, Agenten)
import { MCP, REPO, base, beispiel, groesse, version } from '../lib/seite'

const ZEILEN: [string, string][] = [
  ['Export', 'PowerPoint mit einzeln bearbeitbaren Texten, Bildern und Diagrammen, eingebetteten Schriften und Animationen. Dazu PDF, PNG und Markdown.'],
  ['Layouts', '29 Layouts, ruhig gestaltet nach den Regeln guter Designer statt bunter Vorlagen. Für Folien, Social-Formate und A4.'],
  ['Prüfung', 'Autofit und Lint auf jeder Folie: nichts läuft über, nichts ist zu klein, nichts steht zu dicht.'],
  ['Vortrag', 'Du siehst Notizen, Uhr und nächste Folie, das Publikum nur die Folien. Das Handy wird zur Fernbedienung, Laserpointer und Stift sind dabei.'],
  ['KI', 'Bring deine eigene mit: Claude, ChatGPT oder Mistral.'],
  ['Daten', 'Kein Konto, keine Cloud von uns. Deine Präsentationen liegen als Datei auf deinem Rechner.'],
  ['Preis', '0 €. Open Source unter AGPL-3.0.'],
]
---

<section class="abschnitt" id="alles">
  <div class="wrap">
    <div class="blatt-kopf">
      <h2>Datenblatt</h2>
      <span class="mono">Deckwerk {version ? version.split(' ')[0] : ''}</span>
    </div>
    <dl class="blatt">
      {
        ZEILEN.map(([k, v]) => (
          <div data-zeigen>
            <dt class="mono">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    {beispiel && <p class="blatt-dl"><a class="pfeil" href={`${base}${beispiel}`} download>Beispiel-PowerPoint laden ({groesse(beispiel)})</a></p>}
  </div>
</section>

<section class="abschnitt dunkel agenten" id="agenten">
  <div class="wrap agenten-in">
    <div>
      <h2>Für<br /><span class="akzent">Agenten.</span></h2>
      <p class="unterzeile">Ein MCP-Server mit 20 Werkzeugen. Claude Code, Codex und Vibe bauen Decks direkt aus dem Terminal.</p>
      <a class="pfeil" href={REPO}>Quellcode auf GitHub</a>
    </div>
    <div class="terminal">
      <p class="terminal-leiste mono"><span>Terminal</span><span>MCP</span></p>
      <div class="befehl">
        <code>{MCP}</code>
        <button type="button" data-copy={MCP}>Kopieren</button>
      </div>
      <pre><span class="akzent">$</span> claude "Quartalsupdate aus zahlen.csv, 8 Folien"
<span class="terminal-leise">  create_deck · add_slides · render_overview · lint_deck
  ✓ 8 Folien geprüft · save_deck</span></pre>
    </div>
  </div>
</section>

<style is:global>
  .blatt-kopf { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 3px solid var(--ink); }
  .blatt-kopf h2 { font-size: clamp(3rem, 6vw, 5.5rem); }
  .blatt > div { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 1.5rem; padding: 1.4rem 0; border-bottom: 1px solid var(--ink); }
  .blatt dt { padding-top: 0.45em; }
  .blatt dd { font-size: clamp(1.2rem, 1.8vw, 1.6rem); line-height: 1.35; max-width: 52ch; }
  .blatt-dl { margin-top: 1.5rem; }
  @media (max-width: 760px) { .blatt > div { grid-template-columns: 1fr; gap: 0.4rem; } }

  .agenten-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .agenten h2 { font-size: clamp(3.5rem, 7vw, 6.5rem); }
  .agenten .unterzeile { margin-block: 1.5rem 0.5rem; }
  .agenten .pfeil { color: var(--dunkel-text); }
  .terminal { min-width: 0; border: 1px solid var(--dunkel-linie); }
  .terminal-leiste { display: flex; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid var(--dunkel-linie); color: var(--dunkel-muted); }
  .terminal .befehl { outline: 0; border-bottom: 1px solid var(--dunkel-linie); }
  .terminal pre { margin: 0; padding: 18px 16px 22px; font-size: 0.875rem; line-height: 1.7; white-space: pre-wrap; }
  .terminal-leise { color: var(--dunkel-muted); }
  @media (max-width: 860px) { .agenten-in { grid-template-columns: 1fr; } }
</style>
