---
// Folien-Wand: zwei Reihen echter Folien, gegenläufig, auf dem Grau der Arbeitsfläche
import { Image } from 'astro:assets'
import { bild } from '../lib/seite'

const REIHEN = [
  ['strategie-1', 'pitch-5', 'foto-2', 'quartal-4', 'strategie-4', 'pitch-11', 'foto-7', 'quartal-3'],
  ['pitch-8', 'strategie-5', 'foto-6', 'pitch-1', 'quartal-6', 'strategie-9', 'foto-4', 'pitch-7'],
]
---

<section class="wand" aria-label="Folien, die Deckwerk gebaut hat">
  <p class="wand-text klein">Echte Ausgaben von Deckwerk, nichts nachbearbeitet</p>
  {
    REIHEN.map((reihe, r) => (
      <div class:list={['wand-reihe', { rueck: r === 1 }]}>
        {[0, 1].map((kopie) =>
          reihe.map((id) => (
            <Image {...bild(id, '400px', [400, 800])} class="folie" loading="lazy" aria-hidden={kopie === 1 ? 'true' : undefined} alt={kopie === 1 ? '' : bild(id, '').alt} />
          )),
        )}
      </div>
    ))
  }
</section>

<style is:global>
  .wand { padding-block: 0 clamp(4rem, 8vw, 6rem); overflow: hidden; }
  .wand-text { margin-bottom: 1.5rem; text-align: center; }
  .wand-reihe { display: flex; gap: 24px; width: max-content; padding-block: 6px 18px; animation: wand-lauf 110s linear infinite; }
  .wand-reihe.rueck { animation-direction: reverse; animation-duration: 130s; }
  .wand-reihe .folie { width: clamp(240px, 28vw, 380px); flex: none; }
  .wand:hover .wand-reihe { animation-play-state: paused; }
  @keyframes wand-lauf { to { transform: translateX(calc(-50% - 12px)); } }
  @media (prefers-reduced-motion: reduce) { .wand-reihe { animation: none; } .wand { overflow-x: auto; } }
</style>
