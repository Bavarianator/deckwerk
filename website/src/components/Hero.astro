---
// Hero = Startbildschirm der App (Start.tsx): große Frage, Eingabefeld mit rundem Pfeil, Beispiel-Pillen.
// Live-Demo: Das Feld nimmt einen eigenen Satz an. Maschine.astro sucht das passendste echte Beispiel-Deck und baut es im App-Fenster darunter;
// ohne Eingabe tippt sie selbst ein Beispiel. Eine KI läuft hier nicht (statische Seite, nichts von Dritten), das sagt die Demo offen.
import { base, decks, version } from '../lib/seite'
import Maschine from './Maschine.astro'

const satz = (d: (typeof decks)[string]) => `${d.title.replace(/ – .*/, '')} für ${d.brief.audience ?? 'das Team'}. Ziel: ${d.brief.goal ?? 'eine klare Entscheidung'}.`
const erstes = Object.values(decks)[0]
const KURZ: Record<string, string> = { vortrag: 'Vortrag halten', agenten: 'Für Agenten' } // Pillen-Beschriftung, sonst Titel
---

<section class="hero">
  <div class="hero-weiss"><div class="wrap hero-in">
    <img class="hero-logo" src={`${base}favicon.svg`} alt="" width="56" height="56" />
    <h1>Ein Satz.<br />Eine Präsentation.</h1>
    <p class="unterzeile">Deckwerk schreibt die Geschichte, gestaltet jede Folie, prüft sie und gibt dir eine PowerPoint, die du weiterbearbeiten kannst.</p>

    <form class="feld" action={`${base}beispiele/#demo`}>
      <label class="sr" for="demo-satz">Worum geht es in deiner Präsentation?</label>
      <textarea id="demo-satz" name="satz" rows="2" placeholder="Zum Beispiel: Quartalsbericht für die Geschäftsführung, 8 Folien, Fokus auf Wachstum">{satz(erstes)}</textarea>
      <div class="feld-leiste">
        <span class="feld-l">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" /></svg>
          <span>Claude</span>
        </span>
        <button type="submit" class="round feld-los" aria-label="Deck bauen"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg></button>
      </div>
    </form>
    <p class="feld-hinweis klein">Probier es: Schreib deinen eigenen Satz und schick ihn ab.</p>
    <noscript><style>.feld-chips { display: none !important; }</style></noscript>
    <div class="feld-chips" role="group" aria-label="Beispiel wählen und bauen lassen">
      {
        Object.entries(decks).map(([name, d], i) => (
          <button type="button" class="pill" data-deck={name} data-satz={satz(d)} aria-pressed={i === 0 ? 'true' : 'false'}>
            {KURZ[name] ?? d.title.replace(/ – .*/, '')}
          </button>
        ))
      }
    </div>

    <p class="aktionen hero-aktionen">
      <a class="knopf" href={`${base}laden/`}>Kostenlos laden</a>
      <a class="pfeil" href={`${base}beispiele/`}>Beispiele ansehen</a>
    </p>
    <p class="klein hero-meta">{version ? `Version ${version.split(' ')[0]} · ` : ''}Mac und Linux · Kostenlos und Open Source</p>
  </div></div>
  <Maschine />
</section>

<style is:global>
  .hero-weiss { background: var(--panel); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
  .hero-in { display: flex; flex-direction: column; align-items: center; padding-top: clamp(3rem, 7vw, 5.5rem); text-align: center; }
  .hero-logo { margin-bottom: 1.5rem; }
  /* Eingabefeld wie .home-field */
  .feld { width: min(720px, 100%); margin-top: 2.5rem; display: flex; flex-direction: column; gap: 10px; padding: 18px 12px 12px 22px; border: 1px solid rgb(22 22 26 / 0.1); border-radius: 22px; background: #fff; box-shadow: 0 1px 2px rgb(22 22 26 / 0.04), 0 16px 40px rgb(22 22 26 / 0.08); text-align: left; transition: box-shadow 0.2s; }
  .feld.aktiv, .feld:focus-within { box-shadow: 0 0 0 4px rgb(79 82 217 / 0.12), 0 1px 2px rgb(22 22 26 / 0.04), 0 16px 40px rgb(22 22 26 / 0.08); }
  .feld textarea { width: 100%; min-height: 3em; padding: 0 10px 0 0; border: 0; background: transparent; color: var(--text); font: inherit; font-size: clamp(1rem, 1.6vw, 1.125rem); line-height: 1.5; resize: none; outline: none; field-sizing: content; }
  .feld textarea::placeholder { color: var(--faint); }
  .feld-los { border: 0; cursor: pointer; }
  .feld-los:hover { background: var(--accent-hover); }
  .feld-hinweis { margin-top: 12px; }
  .feld-leiste { display: flex; align-items: center; justify-content: space-between; }
  .feld-l { display: inline-flex; align-items: center; gap: 10px; height: 32px; padding: 0 10px; border-radius: 8px; color: var(--muted); font-size: 0.875rem; }
  .round { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; transition: transform 0.2s var(--ease); }
  .feld.drueckt .feld-los { transform: scale(0.88); }
  .feld-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 22px; }
  .feld-chips .pill { height: 34px; padding: 0 16px; font-weight: 400; font-size: 0.875rem; }
  .feld-chips .pill[aria-pressed='true'] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .hero-aktionen { margin-top: 2.25rem; }
  .hero-meta { margin-top: 0.75rem; }
</style>
