---
// Hero: riesige Versalien, ein Satz, zwei Wege. Darunter die Prompt-Maschine.
import { base, version } from '../lib/seite'
import Maschine from './Maschine.astro'
---

<section class="hero">
  <div class="wrap">
    <p class="hero-meta mono">
      {version && <span>v{version.split(' ')[0]}</span>}
      <span>Mac · Linux</span>
      <span>Kostenlos · Open Source</span>
    </p>
    <h1>Ein Satz.<br /><span class="akzent">Ein Deck.</span></h1>
    <div class="hero-fuss">
      <p class="hero-lead">Du sagst, worum es geht. Deckwerk schreibt den roten Faden, setzt jede Folie und prüft sie. Raus kommt eine PowerPoint, die du weiterbearbeiten kannst.</p>
      <p class="aktionen">
        <a class="knopf" href={`${base}laden/`}>Kostenlos laden</a>
        <a class="pfeil" href={`${base}beispiele/`}>Beispiele ansehen</a>
      </p>
    </div>
  </div>
  <Maschine />
</section>

<style is:global>
  .hero { padding-top: clamp(2rem, 5vw, 4.5rem); }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: clamp(1rem, 2vw, 1.75rem); }
  .hero h1 { margin-left: -0.04em; }
  .hero-fuss { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 1.5rem 3rem; align-items: end; margin-top: clamp(2rem, 4vw, 3.5rem); padding-block: 1.75rem clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--ink); }
  .hero-lead { max-width: 36ch; font-size: clamp(1.25rem, 1.9vw, 1.65rem); line-height: 1.3; }
  .hero .aktionen { justify-content: flex-end; }
  @media (max-width: 860px) { .hero-fuss { grid-template-columns: 1fr; } .hero .aktionen { justify-content: flex-start; } }
</style>
