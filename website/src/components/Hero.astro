---
// Hero: Name, Versprechen, Knöpfe; darunter die Live-Szene der App
import AppFilm from './AppFilm.astro'
---

<section class="hero">
  <div class="wrap hero-kopf">
    <p class="hero-marke">Deckwerk</p>
    <h1>Ein Satz.<br />Eine Präsentation.</h1>
    <p class="unterzeile">Deckwerk schreibt die Geschichte, gestaltet jede Folie und gibt dir eine PowerPoint, die du weiterbearbeiten kannst.</p>
    <p class="aktionen">
      <a class="knopf" href="#laden">Kostenlos laden</a>
      <a class="pfeil" href="#demo">Beispiele ansehen</a>
    </p>
  </div>
  <div class="wrap hero-app">
    <AppFilm />
  </div>
</section>

<style is:global>
  .hero { padding-block: clamp(4rem, 10vw, 8rem) clamp(4rem, 8vw, 6rem); text-align: center; overflow: hidden; }
  .hero-marke { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 600; color: var(--muted); margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .hero .unterzeile { max-width: 34ch; }
  .hero-app { margin-top: clamp(3rem, 7vw, 5rem); }
</style>
