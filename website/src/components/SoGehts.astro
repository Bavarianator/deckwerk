---
// Drei Schritte, jeder mit einer kleinen Live-Animation (reines CSS, läuft nur im Bild, steht bei „Bewegung reduzieren“)
import { Image } from 'astro:assets'
import { bild } from '../lib/seite'

const BAU = ['pitch-1', 'pitch-3', 'pitch-5', 'pitch-8', 'pitch-9', 'pitch-11']
const VORTRAG = ['foto-1', 'foto-2', 'foto-3']
---

<section class="abschnitt grau" id="so-gehts">
  <div class="wrap">
    <header class="kopf-mitte">
      <h2>So einfach.</h2>
      <p class="unterzeile">Du erzählst, Deckwerk baut. Gefällt dir etwas nicht, sag es: „Mach Folie 3 ruhiger.“</p>
    </header>
    <ol class="schritte">
      <li>
        <div class="mini mini-tippen" aria-hidden="true">
          <span class="mini-feld"><span>Pitch für einen Schulbuchverlag</span></span>
        </div>
        <span class="schritt-nr">1</span>
        <h3>Erzählen</h3>
        <p>Ein Satz, worum es geht und für wen. Material kannst du anhängen.</p>
      </li>
      <li>
        <div class="mini mini-bauen" aria-hidden="true">
          {BAU.map((id) => <Image {...bild(id, '90px', [180])} alt="" loading="lazy" />)}
        </div>
        <span class="schritt-nr">2</span>
        <h3>Zurücklehnen</h3>
        <p>Deckwerk baut den roten Faden, gestaltet und prüft jede Folie.</p>
      </li>
      <li>
        <div class="mini mini-vortrag" aria-hidden="true">
          {VORTRAG.map((id) => <Image {...bild(id, '260px', [260, 520])} alt="" loading="lazy" />)}
          <span class="mini-balken"></span>
        </div>
        <span class="schritt-nr">3</span>
        <h3>Präsentieren</h3>
        <p>Direkt vortragen oder als PowerPoint weitergeben.</p>
      </li>
    </ol>
  </div>
</section>

<style is:global>
  .schritte { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2vw, 1.5rem); }
  .schritte li { min-width: 0; padding: clamp(1.75rem, 3.5vw, 2.5rem); background: var(--kachel); border-radius: 28px; }
  .schritt-nr { display: block; font-size: 0.9rem; font-weight: 600; color: var(--accent); margin-bottom: 0.4rem; }
  .schritte p { margin-top: 0.6rem; color: var(--muted); font-size: 1.05rem; }
  @media (max-width: 820px) { .schritte { grid-template-columns: 1fr; } }

  /* Mini-Szenen: gleiche Höhe, laufen in Schleife; .bewegt setzt das Skript in Seite.astro, solange die Kachel im Bild ist */
  .mini { position: relative; height: 150px; margin-bottom: 1.75rem; border-radius: 16px; background: var(--grau); overflow: hidden; }
  .mini * { animation-play-state: paused !important; }
  .bewegt .mini * { animation-play-state: running !important; }

  .mini-tippen { display: grid; place-items: center; padding: 0 16px; }
  .mini-feld { width: 100%; padding: 12px 14px; border-radius: 12px; background: var(--kachel); box-shadow: 0 4px 14px rgb(0 0 0 / 0.08); font-size: 0.9rem; white-space: nowrap; overflow: hidden; }
  .mini-feld span { display: inline-block; clip-path: inset(0 100% 0 0); animation: mini-tipp 5s steps(31) infinite; }
  @keyframes mini-tipp { 0% { clip-path: inset(0 100% 0 0); } 55%, 90% { clip-path: inset(0 0 0 0); } 100% { clip-path: inset(0 100% 0 0); } }

  .mini-bauen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 18px; align-content: center; }
  .mini-bauen img { width: 100%; border-radius: 3px; box-shadow: 0 2px 6px rgb(0 0 0 / 0.12); opacity: 0; animation: mini-bau 6s infinite; }
  .mini-bauen img:nth-child(2) { animation-delay: 0.35s; }
  .mini-bauen img:nth-child(3) { animation-delay: 0.7s; }
  .mini-bauen img:nth-child(4) { animation-delay: 1.05s; }
  .mini-bauen img:nth-child(5) { animation-delay: 1.4s; }
  .mini-bauen img:nth-child(6) { animation-delay: 1.75s; }
  @keyframes mini-bau { 0% { opacity: 0; transform: translateY(6px) scale(0.96); } 8%, 85% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; } }

  .mini-vortrag { background: #000; display: grid; place-items: center; padding: 14px 22px 22px; }
  .mini-vortrag img { grid-area: 1 / 1; width: 100%; border-radius: 3px; opacity: 0; animation: mini-folie 9s infinite; }
  .mini-vortrag img:nth-child(2) { animation-delay: 3s; }
  .mini-vortrag img:nth-child(3) { animation-delay: 6s; }
  @keyframes mini-folie { 0% { opacity: 0; } 4%, 33% { opacity: 1; } 38%, 100% { opacity: 0; } }
  .mini-balken { position: absolute; left: 22px; right: 22px; bottom: 10px; height: 3px; border-radius: 2px; background: rgb(255 255 255 / 0.2); overflow: hidden; }
  .mini-balken::after { content: ''; position: absolute; inset: 0; background: #fff; transform-origin: left; animation: mini-lauf 9s linear infinite; }
  @keyframes mini-lauf { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .mini * { animation: none !important; opacity: 1 !important; }
    .mini-feld span { clip-path: none; }
    .mini-vortrag img:not(:first-child) { display: none; }
    .mini-balken::after { transform: scaleX(0.33); }
  }
</style>
