---
// Stil-Umschalter ohne JS: Radio + :has(); die Regeln je Stil entstehen aus THEMES, ein neuer Look braucht nur seinen Eintrag dort
import { Image } from 'astro:assets'
import { THEMES, bild } from '../lib/seite'

const ids = Object.keys(THEMES)
const sichtbar = ids.map((id) => `.looks:has([value='${id}']:checked) [data-look='${id}']`).join(',\n') + ' { display: grid; }'
---

<section class="abschnitt dunkel" id="looks">
  <div class="wrap">
    <header class="abschnitt-kopf">
      <h2>Ein Inhalt.<br />Viele Looks.</h2>
      <p class="unterzeile">Ein Klick, und die ganze Präsentation sieht anders aus. Oder Deckwerk entwirft einen eigenen Stil zum Thema.</p>
    </header>
    <div class="looks">
      <div class="pillen" role="radiogroup" aria-label="Stil wählen">
        {
          Object.entries(THEMES).map(([id, name], i) => (
            <label>
              <input type="radio" name="look" value={id} checked={i === 0} />
              <span class="pille">{name}</span>
            </label>
          ))
        }
      </div>
      {
        ids.map((id) => (
          <div class="look" data-look={id}>
            {[1, 2, 3].map((n) => (
              <Image {...bild(`look-${id}-${n}`, n === 1 ? '(max-width: 760px) 100vw, 740px' : '(max-width: 760px) 100vw, 370px')} class="folie" />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Stile wechseln von selbst, solange der Abschnitt im Bild ist; nach dem ersten eigenen Klick nicht mehr
  const looks = document.querySelector<HTMLElement>('.looks')
  if (looks && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const radios = [...looks.querySelectorAll<HTMLInputElement>('input[name=look]')]
    let selbst = false, sichtbar = false
    looks.addEventListener('pointerdown', () => (selbst = true))
    looks.addEventListener('keydown', () => (selbst = true))
    new IntersectionObserver(([e]) => (sichtbar = e.isIntersecting), { threshold: 0.4 }).observe(looks)
    setInterval(() => {
      if (selbst || !sichtbar) return
      const i = radios.findIndex((r) => r.checked)
      radios[(i + 1) % radios.length].checked = true
    }, 3200)
  }
</script>

<style is:global set:html={sichtbar}></style>
<style is:global>
  .looks label { cursor: pointer; }
  .looks input { position: absolute; opacity: 0; pointer-events: none; }
  .looks input:focus-visible + .pille { outline: 3px solid var(--accent); outline-offset: -3px; }
  .look { display: none; animation: look-ein 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); grid-template-columns: 2fr 1fr; gap: clamp(1rem, 2vw, 1.5rem); }
  .look > :first-child { grid-row: span 2; }
  @keyframes look-ein { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) { .look { animation: none; } }
  @media (max-width: 760px) { .look { grid-template-columns: 1fr; } .look > :first-child { grid-row: auto; } }
</style>
