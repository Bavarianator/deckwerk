---
// „Weiter“: Regal wie „Mit einer Vorlage beginnen“ im Startbildschirm der App – Deckblatt, Titel, eine Zeile
import { Image } from 'astro:assets'
import { base, bild } from '../lib/seite'

const WEGE = [
  { pfad: 'beispiele/', titel: 'Beispiele', satz: 'Vier Decks zum Durchklicken, fünf Looks, vier Formate', bild: 'pitch-1' },
  { pfad: 'funktionen/', titel: 'Funktionen', satz: 'PowerPoint, geprüfte Folien, Vortrag, Agenten', bild: 'quartal-4' },
  { pfad: 'laden/', titel: 'Kostenlos laden', satz: 'Mac und Linux, in zwei Minuten startklar', bild: 'strategie-1' },
]
---

<section class="abschnitt regal-abschnitt">
  <div class="wrap">
    <h2 class="regal-kopf">Weiter</h2>
    <div class="regal">
      {
        WEGE.map((w) => (
          <a class="regal-deck" href={`${base}${w.pfad}`} data-zeigen>
            <Image {...bild(w.bild, '(max-width: 760px) 90vw, 360px', [360, 720])} alt="" class="folie" loading="lazy" />
            <b>{w.titel}</b>
            <span>{w.satz}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .regal-abschnitt { padding-top: 0; }
  .regal-kopf { margin-bottom: 18px; font-size: 0.875rem; font-weight: 600; letter-spacing: 0; color: var(--muted); }
  .regal { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .regal-deck { display: flex; flex-direction: column; gap: 4px; color: var(--text); }
  .regal-deck:hover { color: var(--text); text-decoration: none; }
  .regal-deck .folie { margin-bottom: 10px; box-shadow: 0 1px 2px rgb(22 22 26 / 0.06), 0 10px 24px rgb(22 22 26 / 0.12); transition: transform 0.2s; }
  .regal-deck:hover .folie { transform: translateY(-2px); }
  .regal-deck b { font-weight: 600; }
  .regal-deck span { font-size: 0.875rem; color: var(--muted); }
  @media (max-width: 760px) { .regal { grid-template-columns: 1fr; } }
</style>
