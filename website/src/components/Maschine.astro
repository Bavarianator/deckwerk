---
// Das App-Fenster (Editor aus TopBar.tsx und shell.css nachgebaut): Kopfleiste, Filmstreifen, Bühne, Notizen, Dock.
// Ein Lauf: Satz ins Feld des Heros tippen → Pfeil → Folien entstehen nacheinander im Filmstreifen, die Bühne zeigt die neueste,
// die Blase meldet den Fortschritt, am Ende „geprüft“. Alles echte Folien und Titel aus folien.json.
// Ohne JS und bei „Bewegung reduzieren“ steht das fertige erste Deck da.
import { Image } from 'astro:assets'
import { THEMES, base, bild, decks, folien } from '../lib/seite'

const titel = (id: string) => folien[id].title || folien[id].layout
---

<section class="maschine" aria-label="So sieht Deckwerk bei der Arbeit aus">
  <div class="wrap">
    {
      Object.entries(decks).map(([name, d], i) => (
        <div class="fenster" data-deck={name} hidden={i > 0}>
          <div class="fe-top">
            <span class="fe-l">
              <span class="plain fe-tint"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>Decks</span>
            </span>
            <span class="fe-titel"><b>{d.title}</b><span>{d.slides.length} Folien · {THEMES[d.theme] ?? d.theme}</span></span>
            <span class="fe-r">
              <span class="plain fe-nur-breit"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" /><path d="m16 6-4-4-4 4" /><path d="M12 2v13" /></svg>Exportieren</span>
              <span class="pill tint fe-praes"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 3l14 9-14 9z" /></svg>Präsentieren</span>
            </span>
          </div>
          <div class="fe-work">
            <ol class="fe-film" aria-label="Folien">
              {d.slides.map((id, n) => (
                <li class:list={{ aktiv: n === 0 }}>
                  <button type="button" aria-label={`Folie ${n + 1}`}>
                    <span class="fe-nr">{n + 1}</span>
                    <Image {...bild(id, '160px', [160, 320])} class="fe-thumb" loading="lazy" />
                  </button>
                </li>
              ))}
            </ol>
            <div class="fe-mitte">
              <div class="fe-buehne">
                {d.slides.map((id, n) => (
                  <Image {...bild(id, '(max-width: 900px) 90vw, 720px', [480, 960, 1440])} class:list={['folie gross fe-folie', { an: n === 0 }]} loading={i === 0 && n === 0 ? 'eager' : 'lazy'} />
                ))}
              </div>
              <div class="fe-notiz">
                <span class="fe-notiz-kopf">Notizen</span>
                {d.slides.map((id, n) => <p hidden={n > 0}>{folien[id].notes}</p>)}
              </div>
              <div class="fe-dock">
                <p class="fe-blase material">
                  <span class="fe-ok"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span>
                  <span class="fe-spin" aria-hidden="true"></span>
                  <span class="fe-blase-text" data-fertig={`${d.slides.length} Folien gestaltet und geprüft`}>{d.slides.length} Folien gestaltet und geprüft</span>
                  <a class="fe-blase-link" href={`${base}laden/`} hidden>App laden</a>
                </p>
                <div class="fe-cap material">
                  <svg class="fe-funke" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 15.5A2 2 0 0 0 8.5 14.06l-6.14-1.58a.5.5 0 0 1 0-.96L8.5 9.94A2 2 0 0 0 9.94 8.5l1.58-6.14a.5.5 0 0 1 .96 0L14.06 8.5A2 2 0 0 0 15.5 9.94l6.14 1.58a.5.5 0 0 1 0 .96L15.5 14.06a2 2 0 0 0-1.44 1.44l-1.58 6.14a.5.5 0 0 1-.96 0z" /></svg>
                  <span class="fe-cap-text">Sag, was sich ändern soll – zum Beispiel „Mach Folie 3 ruhiger“</span>
                  <span class="round fe-cap-los"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg></span>
                </div>
              </div>
            </div>
          </div>
          <ul class="fe-titel-liste" hidden>
            {d.slides.map((id) => <li>{titel(id)}</li>)}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<script>
  const m = document.querySelector<HTMLElement>('.maschine')
  const feld = document.querySelector<HTMLFormElement>('form.feld')
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.feld-chips .pill')]
  // Ohne „Bewegung reduzieren“ animiert; sonst springt alles sofort in den fertigen Zustand
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (m && feld) {
    const fenster = [...m.querySelectorAll<HTMLElement>('.fenster')]
    const eingabe = feld.querySelector('textarea')!
    const warte = (ms: number) => new Promise((r) => setTimeout(r, ms))
    let lauf = 0 // Zähler: ein neuer Lauf bricht den alten ab
    let beispiel = eingabe.value // was die Demo selbst ins Feld geschrieben hat
    let letztesEigen: string | null = null // eigener Satz des laufenden Laufs

    // Welches echte Beispiel passt zum eigenen Satz? Schlichte Stichwortwertung, keine KI.
    const WORTE: Record<string, string[]> = {
      strategie: ['strategie', 'ziel', 'vision', 'beirat', 'vorstand', 'führung', 'schwerpunkt', 'roadmap', 'plan', '2027', '2028', 'zukunft', 'mission', 'transformation', 'team', 'workshop'],
      pitch: ['pitch', 'investor', 'start', 'startup', 'produkt', 'app', 'idee', 'gründ', 'kunde', 'schul', 'verlag', 'bildung', 'lösung', 'markt', 'software', 'ki', 'tool', 'verkauf'],
      quartal: ['quartal', 'q1', 'q2', 'q3', 'q4', 'umsatz', 'vertrieb', 'zahlen', 'bericht', 'kpi', 'status', 'projekt', 'budget', 'controlling', 'ergebnis', 'monat', 'jahr', 'update', 'stellen'],
      foto: ['café', 'cafe', 'restaurant', 'laden', 'standort', 'expansion', 'filiale', 'gastro', 'bank', 'kredit', 'hotel', 'shop', 'eröffn', 'stadt', 'marke', 'event', 'reise'],
    }
    const passend = (satz: string) => {
      const t = satz.toLowerCase()
      let best = 'strategie', punkte = 0
      for (const [deck, worte] of Object.entries(WORTE)) {
        const p = worte.filter((w) => t.includes(w)).length
        if (p > punkte) (best = deck), (punkte = p)
      }
      return best
    }

    const zeige = (f: HTMLElement, n: number) => {
      f.querySelectorAll('.fe-film li').forEach((li, k) => li.classList.toggle('aktiv', k === n))
      f.querySelectorAll('.fe-folie').forEach((img, k) => img.classList.toggle('an', k === n))
      f.querySelectorAll<HTMLElement>('.fe-notiz p').forEach((p, k) => (p.hidden = k !== n))
    }
    const fertig = (f: HTMLElement, eigen: string | null) => {
      const text = f.querySelector<HTMLElement>('.fe-blase-text')!
      const titel = f.querySelector('.fe-titel b')!.textContent!.replace(/ – .*/, '')
      text.textContent = eigen ? `Ähnlichstes Beispiel: „${titel}“ · dein eigenes Deck baut die App` : text.dataset.fertig!
      f.querySelector<HTMLElement>('.fe-blase-link')!.hidden = !eigen
      f.querySelector('.fe-blase')!.classList.remove('arbeitet')
    }

    // satz: Text, den die Demo selbst tippt; eigen: eigener Satz aus dem Feld
    const spiele = async (f: HTMLElement, satz: string | null, eigen: string | null) => {
      const ich = ++lauf
      letztesEigen = eigen
      const film = [...f.querySelectorAll<HTMLElement>('.fe-film li')]
      const titel = [...f.querySelectorAll('.fe-titel-liste li')].map((li) => li.textContent ?? '')
      const blase = f.querySelector<HTMLElement>('.fe-blase')!
      const text = f.querySelector<HTMLElement>('.fe-blase-text')!
      if (satz) eingabe.value = beispiel = satz
      if (ruhig) return fertig(f, eigen)
      f.querySelectorAll('img').forEach((i) => (i.loading = 'eager'))
      f.classList.add('bereit')
      f.querySelector<HTMLElement>('.fe-blase-link')!.hidden = true
      film.forEach((li) => li.classList.remove('da'))
      blase.classList.add('arbeitet')
      text.textContent = eigen ? 'Deckwerk liest dein Briefing …' : 'Deckwerk liest das Briefing …'
      if (satz) {
        feld.classList.add('aktiv')
        for (let n = 0; n <= satz.length; n++) {
          if (ich !== lauf) return
          eingabe.value = beispiel = satz.slice(0, n)
          await warte(n % 6 === 0 ? 55 : 22)
        }
        feld.classList.add('drueckt')
        await warte(220)
        feld.classList.remove('drueckt', 'aktiv')
      } else await warte(600)
      if (ich !== lauf) return
      text.textContent = eigen ? `Passt am besten: Beispiel „${f.querySelector('.fe-titel b')!.textContent!.replace(/ – .*/, '')}“` : `Storyline: ${film.length} Folien`
      await warte(eigen ? 1300 : 700)
      for (let n = 0; n < film.length; n++) {
        if (ich !== lauf) return
        text.textContent = `Folie ${n + 1} von ${film.length}: ${titel[n]}`
        film[n].classList.add('da')
        zeige(f, n)
        await warte(480)
      }
      if (ich !== lauf) return
      fertig(f, eigen)
      await warte(900)
      if (ich === lauf) zeige(f, 0)
    }

    const oeffne = (deck: string) => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.deck === deck)))
      fenster.forEach((f) => (f.hidden = f.dataset.deck !== deck))
      return fenster.find((x) => !x.hidden)!
    }
    const waehle = (b: HTMLButtonElement) => spiele(oeffne(b.dataset.deck!), b.dataset.satz!, null)

    // Erster Lauf, sobald das Fenster im Bild ist; jede eigene Aktion vorher ersetzt ihn
    const start = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return
      start.disconnect()
      waehle(chips.find((c) => c.getAttribute('aria-pressed') === 'true') ?? chips[0])
    }, { rootMargin: '0px 0px -25% 0px' })
    start.observe(m)
    for (const b of chips) b.addEventListener('click', () => (start.disconnect(), waehle(b)))

    // Eigener Satz: Fokus hält das Tippen an und markiert den Beispielsatz, damit man ihn einfach übertippt
    eingabe.addEventListener('focus', () => {
      start.disconnect()
      if (eingabe.value === beispiel || beispiel.startsWith(eingabe.value)) {
        lauf += 1
        feld.classList.remove('aktiv', 'drueckt')
        eingabe.select()
      }
    })
    eingabe.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) (e.preventDefault(), feld.requestSubmit())
    })
    feld.addEventListener('submit', (e) => {
      e.preventDefault()
      const eigen = eingabe.value.trim()
      if (!eigen) return eingabe.focus()
      start.disconnect()
      const f = oeffne(passend(eigen))
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'))
      beispiel = '' // ab jetzt gehört das Feld dem Gast
      const oben = m.getBoundingClientRect().top
      if (oben > innerHeight * 0.6) m.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' })
      spiele(f, null, eigen)
    })

    // Filmstreifen anklicken wie in der App; ein Klick während des Aufbaus beendet ihn sofort
    for (const f of fenster)
      f.querySelectorAll<HTMLElement>('.fe-film button').forEach((b, n) =>
        b.addEventListener('click', () => {
          const lief = f.querySelector('.fe-blase')!.classList.contains('arbeitet')
          lauf += 1
          f.classList.remove('bereit')
          if (lief) fertig(f, letztesEigen)
          zeige(f, n)
        }),
      )
  }
</script>

<style is:global>
  .maschine { padding-block: 0 clamp(4rem, 8vw, 6rem); margin-top: calc(-1 * clamp(1.5rem, 3vw, 2.25rem)); }
  /* Fenster: weißer Rahmen um die graue Arbeitsfläche, wie die App auf dem Bildschirm */
  .fenster { border-radius: 14px; overflow: hidden; background: var(--bg); box-shadow: 0 0 0 1px var(--border), 0 2px 6px rgb(22 22 26 / 0.06), 0 30px 80px -20px rgb(22 22 26 / 0.28); font-size: 13px; text-align: left; }
  .fe-top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; height: 52px; padding: 0 14px 0 10px; }
  .fe-l, .fe-r { display: flex; align-items: center; gap: 2px; min-width: 0; }
  .fe-r { justify-content: flex-end; }
  .fenster .plain { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; border-radius: 8px; color: var(--text); font-size: 13px; }
  .fe-titel { display: flex; align-items: baseline; gap: 6px; min-width: 0; white-space: nowrap; }
  .fe-titel b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  .fe-titel span { color: var(--faint); }
  .fenster .fe-tint { color: var(--accent); }
  .fe-praes { height: 32px; padding: 0 14px; margin-left: 8px; font-size: 13px; }
  .fe-work { display: flex; min-height: 0; }
  .fe-film { flex: none; width: 200px; list-style: none; margin: 0; padding: 8px 14px 24px 8px; display: flex; flex-direction: column; gap: 10px; max-height: 620px; overflow-y: auto; scrollbar-width: thin; }
  .fe-film li { transition: opacity 0.35s var(--ease), transform 0.35s var(--ease); }
  .fe-film button { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 6px; align-items: start; width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: pointer; }
  .fe-nr { padding-top: 1px; color: var(--faint); font-size: 11px; font-weight: 500; text-align: right; font-variant-numeric: tabular-nums; }
  .fe-thumb { width: 100%; border-radius: 6px; box-shadow: 0 0 0 1px var(--border), 0 1px 3px rgb(22 22 26 / 0.08); transition: box-shadow 0.2s; }
  .fe-film li.aktiv .fe-nr { color: var(--accent); font-weight: 700; }
  .fe-film li.aktiv .fe-thumb { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4.5px var(--accent); }
  .fe-mitte { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .fe-buehne { display: grid; padding: 20px 32px 8px; }
  .fe-folie { grid-area: 1 / 1; opacity: 0; transition: opacity 0.35s; }
  .fe-folie.an { opacity: 1; }
  .fe-notiz { display: grid; gap: 2px; padding: 6px 32px 0; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .fe-notiz-kopf { font-size: 12px; font-weight: 600; color: var(--faint); }
  .fe-notiz p { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .fe-dock { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 14px 24px 24px; margin-top: auto; }
  .fe-blase { display: flex; align-items: center; gap: 10px; max-width: min(640px, 100%); min-height: 40px; padding: 6px 14px; border-radius: 20px; font-size: 13.5px; }
  .fe-blase-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fe-blase-link { flex: none; font-weight: 600; white-space: nowrap; }
  .fe-blase-link::after { content: ' ›'; }
  .fe-ok { display: grid; place-items: center; flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--ok); color: #fff; }
  .fe-spin { display: none; flex: none; width: 16px; height: 16px; border: 2px solid var(--accent-soft); border-top-color: var(--accent); border-radius: 50%; animation: fe-dreh 0.9s linear infinite; }
  .fe-blase.arbeitet .fe-ok { display: none; }
  .fe-blase.arbeitet .fe-spin { display: block; }
  @keyframes fe-dreh { to { transform: rotate(360deg); } }
  .fe-cap { display: flex; align-items: center; gap: 10px; width: min(720px, 100%); height: 60px; padding: 0 12px 0 18px; border-radius: 30px; }
  .fe-funke { flex: none; color: var(--accent); }
  .fe-cap-text { flex: 1; min-width: 0; color: var(--faint); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fe-cap-los { width: 34px; height: 34px; opacity: 0.35; }
  /* Gesteuerter Lauf: Filmstreifen füllt sich */
  .fenster.bereit .fe-film li:not(.da) { opacity: 0; transform: translateX(-10px); pointer-events: none; }
  @media (max-width: 900px) {
    .fe-film { display: none; }
    .fe-nur-breit { display: none !important; }
    .fe-titel span { display: none; }
    .fe-buehne { padding: 12px 12px 4px; }
    .fe-notiz { padding: 6px 14px 0; }
    .fe-dock { padding: 12px; }
    .fe-cap-text { font-size: 13px; }
  }
  @media (max-width: 560px) { .fe-l { display: none; } .fe-top { grid-template-columns: minmax(0, 1fr) auto; } }
  @media (prefers-reduced-motion: reduce) { .fe-spin { animation: none; } }
</style>
