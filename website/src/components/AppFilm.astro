---
// Live-Szene: nachgebautes Deckwerk-Fenster (Leiste, Filmstreifen, Bühne, Eingabe) mit echten Folien.
// Ablauf in Schleife: Satz tippen → Storyline → Folien entstehen → geprüft → Präsentieren → als PowerPoint gespeichert.
// Ohne JS und bei „Bewegung reduzieren“ steht der fertige Zustand da; die Schleife läuft nur, solange die Szene sichtbar ist.
import { Image } from 'astro:assets'
import { bild, decks } from '../lib/seite'

const deck = decks.quartal
const ids = deck.slides
const SATZ = 'Quartalsbericht für die Geschäftsführung: Wir liegen 9 % über Plan und brauchen zwei neue Stellen.'
---

<div class="app" data-satz={SATZ} data-n={ids.length} role="img" aria-label={`Deckwerk baut aus einem Satz die Präsentation „${deck.title}“ mit ${ids.length} Folien`}>
  <div class="app-leiste" aria-hidden="true">
    <span class="app-punkte"><i></i><i></i><i></i></span>
    <span class="app-titel">{deck.title}</span>
    <span class="app-praes">▶ Präsentieren</span>
  </div>
  <div class="app-koerper" aria-hidden="true">
    <ol class="app-film">
      {ids.map((id) => <li class="da"><Image {...bild(id, '120px', [240])} alt="" loading="lazy" /></li>)}
    </ol>
    <div class="app-mitte">
      <div class="app-buehne">
        <div class="app-leer weg">Neue Präsentation</div>
        {ids.map((id, n) => <Image {...bild(id, '(max-width: 760px) 90vw, 820px', [480, 960, 1600])} alt="" class:list={['app-folie', { da: n === 0 }]} loading={n === 0 ? 'eager' : 'lazy'} />)}
        <span class="app-chip da">✓ {ids.length} Folien geprüft</span>
        <span class="app-toast">PowerPoint und PDF gespeichert</span>
      </div>
      <div class="app-frage">
        <span class="app-eingabe" data-leer="Sag Deckwerk, was sich ändern soll"></span>
        <span class="app-senden">↑</span>
      </div>
    </div>
  </div>
</div>

<script>
  const app = document.querySelector<HTMLElement>('.app')
  if (app && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const $ = <T extends Element>(s: string) => app.querySelector<T>(s)!
    const film = [...app.querySelectorAll('.app-film li')]
    const folien = [...app.querySelectorAll('.app-folie')]
    const eingabe = $<HTMLElement>('.app-eingabe'), chip = $<HTMLElement>('.app-chip'), toast = $('.app-toast'), leer = $('.app-leer')
    const n = folien.length

    // nur weiterlaufen, solange die Szene im Bild ist
    let sichtbar = false, weiter: (() => void) | null = null
    new IntersectionObserver(([e]) => { sichtbar = e.isIntersecting; if (sichtbar && weiter) (weiter(), (weiter = null)) }, { threshold: 0.25 }).observe(app)
    const pause = async (ms: number) => {
      await new Promise((r) => setTimeout(r, ms))
      if (!sichtbar) await new Promise<void>((r) => (weiter = r))
    }
    const zeige = (k: number) => folien.forEach((f, i) => f.classList.toggle('da', i === k))
    const melde = (text: string) => { chip.textContent = text; chip.classList.add('da') }
    const tippe = async (text: string) => {
      eingabe.classList.add('tippt')
      for (let i = 0; i <= text.length; i++) { eingabe.textContent = text.slice(0, i); await pause(26) }
      await pause(500)
      eingabe.textContent = ''
      eingabe.classList.remove('tippt')
    }

    ;(async () => {
      app.classList.add('laeuft')
      await pause(2500) // erst die fertige Präsentation zeigen, dann von vorn bauen
      for (;;) {
        // Ausgangslage: leeres Deck
        film.forEach((f) => f.classList.remove('da', 'aktiv'))
        zeige(-1)
        leer.classList.remove('weg')
        chip.classList.remove('da')
        await pause(900)
        await tippe(app.dataset.satz!)
        melde('Deckwerk denkt nach …')
        await pause(1300)
        melde('Storyline steht')
        await pause(1000)
        leer.classList.add('weg')
        for (let k = 0; k < n; k++) {
          film.forEach((f, i) => f.classList.toggle('aktiv', i === k))
          film[k].classList.add('da')
          zeige(k)
          melde(`Folie ${k + 1} von ${n} gestaltet`)
          await pause(750)
        }
        melde(`✓ ${n} Folien geprüft`)
        film.forEach((f, i) => f.classList.toggle('aktiv', i === 0))
        zeige(0)
        await pause(1800)
        // Präsentieren: Bühne füllt das Fenster, ein paar Folien weiter
        chip.classList.remove('da')
        app.classList.add('praesentiert')
        for (const k of [0, 1, 2, 3]) { zeige(k); await pause(1400) }
        app.classList.remove('praesentiert')
        zeige(0)
        await pause(500)
        toast.classList.add('da')
        await pause(2200)
        toast.classList.remove('da')
        await pause(1200)
      }
    })()
  }
</script>

<style is:global>
  /* Fenster in den Farben der App (shell.css), Akzent Indigo wie in Deckwerk selbst */
  /* Fenster in den dunklen Farben der App (ui/app.css), Akzent Indigo wie in Deckwerk selbst */
  .app { --app-bg: #0c0d10; --app-panel: #121317; --app-linie: #23262d; --app-text: #e6e8ec; --app-muted: #8f95a1; --app-akzent: #7a86ff;
    max-width: 1040px; margin-inline: auto; text-align: left; background: var(--app-bg); border-radius: 16px; overflow: hidden;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1), 0 40px 100px -20px rgb(0 0 0 / 0.9); font-size: 13px; color: var(--app-text); }
  .app-leiste { display: flex; align-items: center; gap: 14px; height: 40px; padding: 0 14px; background: var(--app-panel); border-bottom: 1px solid var(--app-linie); }
  .app-punkte { display: flex; gap: 7px; }
  .app-punkte i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .app-punkte i:nth-child(2) { background: #febc2e; }
  .app-punkte i:nth-child(3) { background: #28c840; }
  .app-titel { flex: 1; text-align: center; font-weight: 600; color: var(--app-muted); }
  .app-praes { padding: 4px 11px; border-radius: 999px; background: color-mix(in srgb, var(--app-akzent) 14%, transparent); color: var(--app-akzent); font-weight: 600; font-size: 12px; transition: background 0.3s, color 0.3s; }
  .praesentiert .app-praes { background: var(--app-akzent); color: #fff; }

  .app-koerper { display: grid; grid-template-columns: 132px 1fr; height: clamp(300px, 52vw, 600px); }
  .app-film { list-style: none; margin: 0; padding: 12px 14px; min-width: 0; display: flex; flex-direction: column; gap: 10px; overflow: hidden; background: var(--app-panel); border-right: 1px solid var(--app-linie); }
  .app-film li { flex: none; border-radius: 4px; outline: 2px solid transparent; outline-offset: 2px; opacity: 0; transform: translateX(-8px); transition: opacity 0.4s, transform 0.4s, outline-color 0.2s; }
  .app-film li.da { opacity: 1; transform: none; }
  .app-film li.aktiv { outline-color: var(--app-akzent); }
  .app-film img { width: 100%; border-radius: 4px; box-shadow: 0 0 0 1px var(--app-linie); }

  .app-mitte { display: flex; flex-direction: column; min-width: 0; }
  .app-buehne { position: relative; flex: 1; display: grid; place-items: center; padding: 4% 6%; }
  .app-buehne > * { grid-area: 1 / 1; }
  .app-leer { width: 100%; aspect-ratio: 16 / 9; display: grid; place-items: center; border: 1.5px dashed var(--app-linie); border-radius: 8px; color: var(--app-muted); transition: opacity 0.4s; }
  .app-leer.weg { opacity: 0; }
  /* Wechsel ohne Geisterbild: die neue Folie blendet oben ein, die alte bleibt darunter voll stehen und verschwindet erst danach */
  .app-folie { width: 100%; border-radius: 6px; box-shadow: 0 12px 32px rgb(0 0 0 / 0.5); opacity: 0; transition: opacity 0s 0.5s; }
  .app-folie.da { z-index: 1; opacity: 1; transition: opacity 0.45s; }
  .app-chip { z-index: 2; position: absolute; left: 50%; bottom: 14px; translate: -50% 0; padding: 6px 12px; border-radius: 999px; background: var(--app-panel); box-shadow: 0 0 0 1px var(--app-linie), 0 6px 18px rgb(0 0 0 / 0.1); font-weight: 500; white-space: nowrap; opacity: 0; transition: opacity 0.3s; }
  .app-chip.da { opacity: 1; }
  .app-toast { z-index: 2; position: absolute; top: 14px; right: 14px; padding: 8px 14px; border-radius: 10px; background: var(--app-text); color: var(--app-bg); font-weight: 500; opacity: 0; translate: 0 -8px; transition: opacity 0.3s, translate 0.3s; }
  .app-toast.da { opacity: 1; translate: 0 0; }
  .app-toast::before { content: '✓ '; }

  .app-frage { display: flex; align-items: center; gap: 10px; margin: 0 6% 16px; padding: 9px 9px 9px 14px; background: var(--app-panel); border-radius: 12px; box-shadow: 0 0 0 1px var(--app-linie), 0 4px 14px rgb(0 0 0 / 0.06); transition: opacity 0.4s; }
  .app-eingabe { flex: 1; min-width: 0; min-height: 1.5em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .app-eingabe:empty::before { content: attr(data-leer); color: var(--app-muted); }
  .app-eingabe.tippt::after { content: ''; display: inline-block; width: 1.5px; height: 1.1em; margin-left: 1px; vertical-align: -0.2em; background: var(--app-akzent); animation: blinken 1s steps(1) infinite; }
  .app-senden { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: var(--app-akzent); color: #fff; font-weight: 700; }

  /* Präsentieren: Filmstreifen und Eingabe weichen, dunkler Grund */
  .app.praesentiert .app-koerper { background: #000; }
  .app.praesentiert .app-koerper { grid-template-columns: 0px 1fr; }
  .app.praesentiert .app-film { padding-inline: 0; border: 0; }
  .app.praesentiert .app-frage { opacity: 0; }
  .app-koerper { transition: background 0.6s, grid-template-columns 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes blinken { 50% { opacity: 0; } }

  @media (max-width: 700px) {
    .app-koerper { grid-template-columns: 1fr; height: auto; }
    .app-film { display: none; }
    .app-buehne { padding: 6% 5% 12%; }
    .app-frage { margin: 0 5% 12px; }
    .app-titel, .app-chip { font-size: 11px; }
  }
</style>
