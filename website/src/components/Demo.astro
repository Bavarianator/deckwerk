---
// Live-Demo: ein großes Deck zum Durchklicken; darunter nur Steuerung und die Sprechernotiz
import { Image } from 'astro:assets'
import { base, bild, decks, folien, groesse } from '../lib/seite'
---

<section class="abschnitt demo-abschnitt" id="demo">
  <div class="wrap">
    <div class="pillen" role="group" aria-label="Beispiel wählen">
      {
        Object.entries(decks).map(([name, d], i) => (
          <button type="button" class="pille" data-deck={name} aria-pressed={i === 0 ? 'true' : 'false'}>
            {d.title}
          </button>
        ))
      }
    </div>
    {
      Object.entries(decks).map(([name, d], i) => (
        <div class="spieler" data-deck={name} hidden={i > 0}>
          <div class="buehne" tabindex="0" aria-label={`${d.title}: klicken oder Pfeiltasten zum Blättern`}>
            {d.slides.map((id, n) => (
              <Image {...bild(id, '(max-width: 1000px) 100vw, 960px')} class="folie" hidden={n > 0} loading="lazy" />
            ))}
          </div>
          <div class="leiste">
            <button type="button" data-schritt="-1" aria-label="Vorige Folie">‹</button>
            <span class="zaehler" aria-live="polite">1 / {d.slides.length}</span>
            <button type="button" data-schritt="1" aria-label="Nächste Folie">›</button>
          </div>
          <div class="notiz">
            {d.slides.map((id, n) => <p hidden={n > 0}>{folien[id].notes || ''}</p>)}
          </div>
          <p class="downloads">
            {d.brief.audience && <span>Für {d.brief.audience}</span>}
            {d.dl.map((f) => (
              <a href={`${base}${f}`} download>
                {f.endsWith('.pptx') ? 'PowerPoint' : 'PDF'} laden <small>{groesse(f)}</small>
              </a>
            ))}
          </p>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Deck wählen, blättern per Klick, Pfeiltasten und Knöpfe
  const wahl = [...document.querySelectorAll<HTMLButtonElement>('#demo .pille')]
  const spieler = [...document.querySelectorAll<HTMLElement>('.spieler')]
  for (const b of wahl)
    b.addEventListener('click', () => {
      wahl.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
      spieler.forEach((s) => (s.hidden = s.dataset.deck !== b.dataset.deck))
    })
  for (const s of spieler) {
    const buehne = s.querySelector<HTMLElement>('.buehne')!
    const bilder = [...buehne.querySelectorAll('img')]
    const notizen = [...s.querySelectorAll<HTMLElement>('.notiz p')]
    const zaehler = s.querySelector('.zaehler')!
    let i = 0
    const zeige = (n: number) => {
      i = (n + bilder.length) % bilder.length
      bilder.forEach((f, k) => (f.hidden = k !== i))
      notizen.forEach((p, k) => (p.hidden = k !== i))
      zaehler.textContent = `${i + 1} / ${bilder.length}`
      if (bilder[i + 1]) bilder[i + 1].loading = 'eager' // nächste Folie vorladen
    }
    buehne.addEventListener('click', () => zeige(i + 1))
    s.querySelectorAll<HTMLButtonElement>('[data-schritt]').forEach((b) => b.addEventListener('click', () => zeige(i + Number(b.dataset.schritt))))
    s.addEventListener('keydown', (e) => {
      const schritt = { ArrowRight: 1, PageDown: 1, ArrowLeft: -1, PageUp: -1 }[e.key]
      if (!schritt) return
      e.preventDefault()
      zeige(i + schritt)
    })
  }
</script>

<style is:global>
  .demo-abschnitt { padding-top: 0; }
  .spieler { display: grid; grid-template-columns: minmax(0, 9fr) minmax(0, 3fr); gap: 0 clamp(1.5rem, 3vw, 3rem); align-items: start; }
  .spieler > :not(.buehne) { grid-column: 2; }
  .buehne { grid-row: 1 / span 4; }
  .buehne { cursor: pointer; }
  .buehne:hover .folie { outline: 3px solid var(--accent); }
  .leiste { display: flex; align-items: stretch; border: 1px solid var(--ink); }
  .leiste button { width: 56px; height: 56px; border: 0; background: var(--ink); color: var(--bg); font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .leiste button:hover { background: var(--accent); color: var(--ink); }
  .zaehler { flex: 1; display: grid; place-items: center; font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 0.95rem; }
  .notiz { min-height: 3em; margin-top: 1.25rem; color: var(--leise); font-size: 1rem; }
  .notiz::before { content: 'Sprechernotiz'; display: block; margin-bottom: 0.4rem; font: 0.8125rem var(--mono); text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .downloads { display: grid; gap: 0.5rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--ink); font-size: 0.95rem; color: var(--muted); }
  @media (max-width: 860px) { .spieler { grid-template-columns: 1fr; } .spieler > :not(.buehne) { grid-column: 1; } .buehne { grid-row: auto; margin-bottom: 1rem; } }
  .downloads small { color: var(--muted); }
</style>
