---
// Kopf einer Unterseite: wie der Startbildschirm der App, mittig auf Weiß
interface Props { titel: string; satz: string }
const { titel, satz } = Astro.props
---

<header class="seitenkopf">
  <div class="wrap">
    <h1 set:html={titel} />
    <p class="unterzeile">{satz}</p>
  </div>
</header>

<style is:global>
  .seitenkopf { padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3rem, 6vw, 4.5rem); background: var(--panel); text-align: center; }
</style>
