---
// Kopf einer Unterseite: riesige Versalien links, ein Satz rechts unten auf der Linie
interface Props { titel: string; satz: string }
const { titel, satz } = Astro.props
---

<header class="seitenkopf wrap">
  <h1 set:html={titel} />
  <p class="unterzeile">{satz}</p>
</header>

<style is:global>
  .seitenkopf { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); align-items: end; gap: 1.5rem 3rem; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem); }
  .seitenkopf h1 { font-size: clamp(4rem, 12vw, 11.5rem); margin-left: -0.04em; }
  .seitenkopf .unterzeile { padding-top: 1rem; border-top: 3px solid var(--accent); }
  @media (max-width: 860px) { .seitenkopf { grid-template-columns: 1fr; } }
</style>
