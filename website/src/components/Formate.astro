---
// Eine Präsentation in vier Formaten; Spaltenbreite = Seitenverhältnis, damit alle gleich hoch stehen
import { Image } from 'astro:assets'
import { bild } from '../lib/seite'

const formate = [
  ['16:9', 'Präsentation', 'format-16-9-1'],
  ['1:1', 'Instagram-Post', 'format-1-1-1'],
  ['9:16', 'Story', 'format-9-16-1'],
  ['A4', 'Handout', 'format-a4-1'],
]
---

<section class="abschnitt" id="formate">
  <div class="wrap">
    <header class="abschnitt-kopf">
      <h2>Jedes Format.</h2>
      <p class="unterzeile">Aus der Präsentation wird ein Post, eine Story oder ein Handout. Deckwerk ordnet alles selbst neu an.</p>
    </header>
    <div class="formate">
      {
        formate.map(([name, wozu, id]) => (
          <figure data-zeigen>
            <Image {...bild(id, '(max-width: 760px) 50vw, 400px')} class="folie" />
            <figcaption>
              <b>{name}</b> {wozu}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .formate { display: grid; grid-template-columns: 1.778fr 1fr 0.5625fr 0.707fr; gap: clamp(1rem, 2.5vw, 2rem); align-items: end; }
  .formate figcaption { margin-top: 1rem; padding-top: 0.6rem; border-top: 1px solid var(--ink); font-size: 0.9rem; color: var(--muted); }
  .formate b { display: block; color: var(--text); font-family: var(--display); font-weight: 900; font-stretch: 62%; font-size: 2.5rem; line-height: 1; }
  @media (max-width: 760px) { .formate { grid-template-columns: 1fr 0.5625fr 0.707fr; } .formate figure:first-child { grid-column: 1 / -1; } }
</style>
