---
// Eine Präsentation in vier Formaten; Spaltenbreite = Seitenverhältnis, damit alle gleich hoch stehen
import { Image } from 'astro:assets'
import { bild } from '../lib/seite'

const formate = [
  ['16:9', 'Präsentation', 'format-16-9-1'],
  ['1:1', 'Instagram-Post', 'format-1-1-1'],
  ['9:16', 'Story', 'format-9-16-1'],
  ['A4', 'Handout', 'format-a4-1'],
]
---

<section class="abschnitt flaeche" id="formate">
  <div class="wrap">
    <header class="kopfzeile">
      <p class="vorzeile">Formate</p>
      <h2>Aus einer Präsentation wird ein Post, eine Story oder ein Handout</h2>
      <p class="lede">Deckwerk ordnet die Folien für das neue Format selbst neu an.</p>
    </header>
    <div class="formate">
      {
        formate.map(([name, wozu, id]) => (
          <figure>
            <Image {...bild(id, '(max-width: 760px) 50vw, 400px')} class="folie" />
            <figcaption>
              <b>{name}</b> {wozu}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .formate { display: grid; grid-template-columns: 1.778fr 1fr 0.5625fr 0.707fr; gap: clamp(1rem, 2.5vw, 2rem); align-items: end; }
  .formate figcaption { margin-top: 0.8rem; font-size: 0.86rem; color: var(--muted); }
  .formate b { color: var(--text); font-weight: 600; margin-right: 0.3rem; }
  @media (max-width: 760px) { .formate { grid-template-columns: 1fr 0.5625fr 0.707fr; } .formate figure:first-child { grid-column: 1 / -1; } }
</style>
