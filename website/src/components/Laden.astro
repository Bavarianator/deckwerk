---
// Installation für Mac und Linux: zwei Kacheln, je ein Hauptweg und eine Alternative
import { APPIMAGE, DMG, INSTALL, INSTALL_MAC, appimage, mb } from '../lib/seite'
---

<section class="abschnitt laden-abschnitt" id="laden">
  <div class="wrap">
    <div class="plattformen">
      <article class="plattform" data-zeigen>
        <h3>Mac</h3>
        <p class="klein">Apple Silicon, ab M1</p>
        <a class="knopf" href={DMG}>Für Mac laden</a>
        <p>Öffnen, in „Programme“ ziehen. Blockiert macOS den ersten Start: Systemeinstellungen → Datenschutz &amp; Sicherheit → „Trotzdem öffnen“.</p>
        <details>
          <summary>Lieber im Terminal</summary>
          <div class="befehl">
            <code>{INSTALL_MAC}</code>
            <button type="button" data-copy={INSTALL_MAC}>Kopieren</button>
          </div>
        </details>
      </article>
      <article class="plattform" data-zeigen>
        <h3>Linux</h3>
        <p class="klein">und Windows mit WSL</p>
        <div class="befehl">
          <code>{INSTALL}</code>
          <button type="button" data-copy={INSTALL}>Kopieren</button>
        </div>
        <p>Im Terminal (<kbd>Strg</kbd>+<kbd>Alt</kbd>+<kbd>T</kbd>) einfügen und Enter drücken. Updates kommen mit demselben Befehl.</p>
        <details>
          <summary>Lieber eine einzelne Datei</summary>
          <p><a href={APPIMAGE}>AppImage laden{appimage ? ` (${mb(appimage.size)})` : ''}</a>, braucht libfuse2.</p>
        </details>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .plattformen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 3px solid var(--ink); }
  .laden-abschnitt { padding-top: 0; }
  .plattform { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; min-width: 0; padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 3rem) 0 0; color: var(--leise); }
  .plattform + .plattform { padding-left: clamp(1.5rem, 3vw, 3rem); padding-right: 0; border-left: 1px solid var(--ink); }
  .plattform h3 { color: var(--text); font-family: var(--display); font-weight: 900; font-stretch: 62%; text-transform: uppercase; font-size: clamp(4rem, 9vw, 7.5rem); line-height: 0.85; }
  .plattform .klein { margin-top: -0.5rem; font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.8125rem; }
  .plattform .befehl { width: 100%; text-align: left; }
  .plattform details { width: 100%; font-size: 0.92rem; }
  .plattform summary { cursor: pointer; list-style: none; font-family: var(--mono); font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.04em; min-height: 44px; display: flex; align-items: center; }
  .plattform summary::-webkit-details-marker { display: none; }
  .plattform summary::after { content: ' ›'; }
  .plattform details[open] summary { margin-bottom: 0.75rem; }
  @media (max-width: 820px) { .plattformen { grid-template-columns: 1fr; } .plattform, .plattform + .plattform { padding: 2rem 0; border-left: 0; } .plattform + .plattform { border-top: 1px solid var(--ink); } }
</style>
