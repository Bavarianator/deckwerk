---
// Installation für Mac und Linux: zwei Kacheln, je ein Hauptweg und eine Alternative
import { APPIMAGE, DMG, INSTALL, INSTALL_MAC, appimage, mb } from '../lib/seite'
---

<section class="abschnitt laden-abschnitt" id="laden">
  <div class="wrap">
    <div class="plattformen">
      <article class="plattform" data-zeigen>
        <h3>Mac</h3>
        <p class="klein">Apple Silicon, ab M1</p>
        <a class="knopf" href={DMG}>Für Mac laden</a>
        <p>Öffnen, in „Programme“ ziehen. Blockiert macOS den ersten Start: Systemeinstellungen → Datenschutz &amp; Sicherheit → „Trotzdem öffnen“.</p>
        <details>
          <summary>Lieber im Terminal</summary>
          <div class="befehl">
            <code>{INSTALL_MAC}</code>
            <button type="button" data-copy={INSTALL_MAC}>Kopieren</button>
          </div>
        </details>
      </article>
      <article class="plattform" data-zeigen>
        <h3>Linux</h3>
        <p class="klein">und Windows mit WSL</p>
        <div class="befehl">
          <code>{INSTALL}</code>
          <button type="button" data-copy={INSTALL}>Kopieren</button>
        </div>
        <p>Im Terminal (<kbd>Strg</kbd>+<kbd>Alt</kbd>+<kbd>T</kbd>) einfügen und Enter drücken. Updates kommen mit demselben Befehl.</p>
        <details>
          <summary>Lieber eine einzelne Datei</summary>
          <p><a href={APPIMAGE}>AppImage laden{appimage ? ` (${mb(appimage.size)})` : ''}</a>, braucht libfuse2.</p>
        </details>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .laden-abschnitt { padding-top: clamp(3rem, 6vw, 4.5rem); }
  .plattformen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; max-width: 980px; margin-inline: auto; }
  .plattform { display: flex; flex-direction: column; align-items: center; gap: 1rem; min-width: 0; padding: clamp(1.75rem, 3.5vw, 2.75rem); text-align: center; color: var(--muted); background: var(--panel); border-radius: 16px; box-shadow: var(--shadow-panel); }
  .plattform h3 { color: var(--text); font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 700; letter-spacing: -0.03em; }
  .plattform .klein { margin-top: -0.6rem; }
  .plattform .befehl { width: 100%; text-align: left; }
  .plattform details { width: 100%; font-size: 0.9rem; }
  .plattform summary { cursor: pointer; list-style: none; color: var(--accent); font-weight: 500; min-height: 40px; display: flex; align-items: center; justify-content: center; }
  .plattform summary::-webkit-details-marker { display: none; }
  .plattform summary::after { content: ' ›'; white-space: pre; }
  .plattform details[open] summary { margin-bottom: 0.5rem; }
  @media (max-width: 820px) { .plattformen { grid-template-columns: 1fr; } }
</style>
