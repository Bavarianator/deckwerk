---
// Rahmen der Seite: Kopf, Fuß, Meta-Tags und die Skripte, die mehrere Abschnitte nutzen (Kopieren, Handy-Menü, Einblenden)
import '@fontsource-variable/inter'
import '../styles/basis.css'
import { FUSS, REPO, SEITEN, base, version } from '../lib/seite'

interface Props { titel?: string; beschreibung?: string }
const {
  titel = 'Deckwerk – Präsentationen aus einem Satz',
  beschreibung = 'Sag in einem Satz, was du zeigen willst: Deckwerk schreibt die Geschichte, gestaltet die Folien, prüft jede einzelne und liefert eine PowerPoint, die du weiterbearbeiten kannst. Kostenlos für Mac und Linux.',
} = Astro.props
const url = new URL(Astro.url.pathname, Astro.site)
const aktiv = (pfad: string) => Astro.url.pathname.endsWith(`/${pfad}`)
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f2f2f4" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(`${base}og.jpg`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="kopf">
      <div class="wrap kopf-in">
        <a class="marke" href={base} aria-label="Deckwerk, zur Startseite">
          <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
          <span>Deckwerk</span>
        </a>
        <nav class="menue" aria-label="Hauptmenü">
          {SEITEN.map(([pfad, label]) => <a href={`${base}${pfad}`} aria-current={aktiv(pfad) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="kopf-r">
          <a class="plain" href={REPO}>GitHub</a>
          <a class="knopf klein" href={`${base}laden/`}>Kostenlos laden</a>
        </div>
        <details class="handy">
          <summary aria-label="Menü öffnen">Menü</summary>
          <nav class="flyout" aria-label="Menü">
            {SEITEN.map(([pfad, label]) => <a href={`${base}${pfad}`} aria-current={aktiv(pfad) ? 'page' : undefined}>{label}</a>)}
            <a href={REPO}>GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss">
      <div class="wrap fuss-in">
        {
          FUSS.map((m) => (
            <nav aria-label={m.name}>
              <p>{m.name}</p>
              {m.links.map(([href, label]) => (
                <a href={href}>{label}</a>
              ))}
            </nav>
          ))
        }
        <p class="fuss-info">
          Präsentationen aus einem Satz. Kostenlos und Open Source{version ? `, Version ${version}` : ''}.
          Schriften unter der SIL Open Font License. Fotos in den Beispielen von Unsplash (<a href={`${REPO}/blob/master/examples/assets/CREDITS.md`}>Bildnachweise</a>).
          Diese Seite setzt keine Cookies, zählt keine Besucher und lädt nichts von Dritten.
        </p>
      </div>
    </footer>

    <script>
      // Kopieren-Knöpfe
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]'))
        b.addEventListener('click', async () => {
          const alt = b.textContent
          try {
            await navigator.clipboard.writeText(b.dataset.copy!)
            b.textContent = 'Kopiert'
          } catch {
            b.textContent = 'Bitte von Hand kopieren'
          }
          setTimeout(() => (b.textContent = alt), 1600)
        })

      // Einblenden beim Scrollen für alles mit [data-zeigen]; Geschwister nacheinander.
      // Klassen setzt erst das Skript: ohne JS ist alles sofort sichtbar.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const zeigen = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('da'), zeigen.unobserve(e.target))), { rootMargin: '0px 0px -8% 0px' })
        document.querySelectorAll<HTMLElement>('[data-zeigen]').forEach((el) => {
          const geschwister = [...el.parentElement!.children].filter((x) => x.hasAttribute('data-zeigen'))
          el.style.transitionDelay = `${Math.max(0, geschwister.indexOf(el)) * 80}ms`
          el.addEventListener('transitionend', () => (el.style.transitionDelay = ''), { once: true }) // Hover danach ohne Verzögerung
          el.classList.add('zeigen')
          zeigen.observe(el)
        })
      }
      // .bewegt startet Mini-Animationen nur, solange sie im Bild sind
      const bewegt = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('bewegt', e.isIntersecting)))
      document.querySelectorAll('[data-bewegt]').forEach((el) => bewegt.observe(el))

      // Handy-Menü: schließen bei Klick daneben, auf einen Link oder mit Esc
      const menue = document.querySelector<HTMLDetailsElement>('details.handy')!
      document.addEventListener('click', (e) => {
        const t = e.target as Element
        if (menue.open && (!menue.contains(t) || t.closest('a'))) menue.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menue.open) (menue.open = false), menue.querySelector('summary')!.focus()
      })
    </script>
  </body>
</html>

<style is:global>
  /* Kopfleiste wie .top in der App: Marke links, Segment-Schalter in der Mitte, Pille rechts */
  .kopf { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px); border-bottom: 1px solid var(--border); }
  .kopf-in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; height: 56px; }
  .marke { display: inline-flex; align-items: center; gap: 9px; color: var(--text); font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .marke:hover { color: var(--text); text-decoration: none; }
  .menue { display: inline-flex; gap: 2px; padding: 2px; border-radius: 9px; background: var(--hover); }
  .menue a { display: inline-flex; align-items: center; height: 30px; padding: 0 14px; border-radius: 7px; color: var(--text); font-size: 0.875rem; }
  .menue a:hover { text-decoration: none; color: var(--text); background: rgb(22 22 26 / 0.05); }
  .menue a[aria-current] { background: var(--panel); box-shadow: 0 1px 3px rgb(22 22 26 / 0.12); font-weight: 600; }
  .kopf-r { display: flex; justify-content: flex-end; align-items: center; gap: 4px; }
  .plain { display: inline-flex; align-items: center; height: 32px; padding: 0 10px; border-radius: 8px; color: var(--text); font-size: 0.875rem; }
  .plain:hover { background: var(--hover); color: var(--text); text-decoration: none; }
  .handy { display: none; position: relative; }
  .handy summary { list-style: none; cursor: pointer; display: flex; align-items: center; height: 36px; padding: 0 12px; border-radius: 999px; background: var(--hover); font-weight: 500; font-size: 0.875rem; }
  .handy summary::-webkit-details-marker { display: none; }
  .handy .flyout { position: absolute; top: calc(100% + 8px); right: 0; z-index: 6; width: min(80vw, 240px); padding: 4px; display: grid; border-radius: 12px; background: var(--material); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px); border: 1px solid var(--border); box-shadow: var(--shadow-float); }
  .handy .flyout a { display: flex; align-items: center; height: 40px; padding: 0 12px; border-radius: 8px; color: var(--text); }
  .handy .flyout a:hover { background: var(--accent); color: #fff; text-decoration: none; }
  @media (max-width: 760px) {
    .kopf-in { grid-template-columns: 1fr auto; }
    .menue, .kopf-r .plain { display: none; }
    .kopf-r { display: none; }
    .handy { display: block; }
  }

  .fuss { padding-block: 3rem 3.5rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.875rem; }
  .fuss-in { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 3rem; }
  .fuss nav { display: grid; align-content: start; gap: 0.3rem; }
  .fuss nav p { margin-bottom: 0.3rem; font-weight: 600; color: var(--text); }
  .fuss nav a { color: var(--muted); }
  .fuss nav a:hover { color: var(--text); }
  .fuss-info { grid-column: 1 / -1; max-width: 90ch; padding-top: 1.25rem; border-top: 1px solid var(--border); font-size: 0.8rem; color: var(--faint); }
  @media (max-width: 760px) { .fuss-in { grid-template-columns: 1fr 1fr; } }
</style>
