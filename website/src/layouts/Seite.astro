---
// Rahmen der Seite: Kopf, Fuß, Meta-Tags und die Skripte, die mehrere Abschnitte nutzen (Kopieren, Handy-Menü, Einblenden)
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/500.css'
import '../styles/basis.css'
import { FUSS, REPO, SEITEN, base, version } from '../lib/seite'

interface Props { titel?: string; beschreibung?: string }
const {
  titel = 'Deckwerk – Präsentationen aus einem Satz',
  beschreibung = 'Sag in einem Satz, was du zeigen willst: Deckwerk schreibt die Geschichte, gestaltet die Folien, prüft jede einzelne und liefert eine PowerPoint, die du weiterbearbeiten kannst. Kostenlos für Mac und Linux.',
} = Astro.props
const url = new URL(Astro.url.pathname, Astro.site)
const aktiv = (pfad: string) => Astro.url.pathname.endsWith(`/${pfad}`)
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#eeeeea" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(`${base}og.jpg`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="kopf">
      <div class="wrap kopf-in">
        <a class="marke" href={base} aria-label="Deckwerk, zur Startseite">Deckwerk</a>
        <nav class="menue mono" aria-label="Hauptmenü">
          {SEITEN.map(([pfad, label]) => <a href={`${base}${pfad}`} aria-current={aktiv(pfad) ? 'page' : undefined}>{label}</a>)}
          <a href={REPO}>GitHub</a>
        </nav>
        <a class="knopf klein schwarz" href={`${base}laden/`}>Laden ↓</a>
        <details class="handy">
          <summary class="mono" aria-label="Menü öffnen">Menü</summary>
          <nav class="flyout" aria-label="Menü">
            {SEITEN.map(([pfad, label]) => <a href={`${base}${pfad}`} aria-current={aktiv(pfad) ? 'page' : undefined}>{label}</a>)}
            <a href={REPO}>GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss dunkel">
      <div class="wrap fuss-in">
        {
          FUSS.map((m) => (
            <nav aria-label={m.name}>
              <p class="mono">{m.name}</p>
              {m.links.map(([href, label]) => (
                <a href={href}>{label}</a>
              ))}
            </nav>
          ))
        }
        <p class="fuss-info">
          Präsentationen aus einem Satz. Kostenlos und Open Source{version ? `, Version ${version}` : ''}.
          Schriften unter der SIL Open Font License. Fotos in den Beispielen von Unsplash (<a href={`${REPO}/blob/master/examples/assets/CREDITS.md`}>Bildnachweise</a>).
          Diese Seite setzt keine Cookies, zählt keine Besucher und lädt nichts von Dritten.
        </p>
      </div>
      <p class="fuss-marke display" aria-hidden="true">Deckwerk</p>
    </footer>

    <script>
      // Kopieren-Knöpfe
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]'))
        b.addEventListener('click', async () => {
          const alt = b.textContent
          try {
            await navigator.clipboard.writeText(b.dataset.copy!)
            b.textContent = 'Kopiert'
          } catch {
            b.textContent = 'Bitte von Hand kopieren'
          }
          setTimeout(() => (b.textContent = alt), 1600)
        })

      // Einblenden beim Scrollen für alles mit [data-zeigen]; Geschwister nacheinander.
      // Klassen setzt erst das Skript: ohne JS ist alles sofort sichtbar.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const zeigen = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('da'), zeigen.unobserve(e.target))), { rootMargin: '0px 0px -8% 0px' })
        document.querySelectorAll<HTMLElement>('[data-zeigen]').forEach((el) => {
          const geschwister = [...el.parentElement!.children].filter((x) => x.hasAttribute('data-zeigen'))
          el.style.transitionDelay = `${Math.max(0, geschwister.indexOf(el)) * 80}ms`
          el.addEventListener('transitionend', () => (el.style.transitionDelay = ''), { once: true }) // Hover danach ohne Verzögerung
          el.classList.add('zeigen')
          zeigen.observe(el)
        })
      }
      // .bewegt startet Mini-Animationen nur, solange sie im Bild sind
      const bewegt = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('bewegt', e.isIntersecting)))
      document.querySelectorAll('[data-bewegt]').forEach((el) => bewegt.observe(el))

      // Handy-Menü: schließen bei Klick daneben, auf einen Link oder mit Esc
      const menue = document.querySelector<HTMLDetailsElement>('details.handy')!
      document.addEventListener('click', (e) => {
        const t = e.target as Element
        if (menue.open && (!menue.contains(t) || t.closest('a'))) menue.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menue.open) (menue.open = false), menue.querySelector('summary')!.focus()
      })
    </script>
  </body>
</html>

<style is:global>
  .kopf { position: sticky; top: 0; z-index: 5; background: var(--bg); border-bottom: 1px solid var(--ink); }
  .kopf-in { display: flex; align-items: center; gap: 2rem; height: 64px; }
  .marke { font-family: var(--display); font-weight: 900; font-stretch: 62%; font-size: 30px; line-height: 1; text-transform: uppercase; text-decoration: none; }
  .marke:hover { color: var(--accent); }
  .menue { display: flex; gap: 2rem; margin-left: auto; }
  .menue a { text-decoration: none; padding-block: 12px; }
  .menue a[aria-current] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .handy { display: none; position: relative; }
  .handy summary { list-style: none; cursor: pointer; display: flex; align-items: center; min-height: 44px; padding: 0 4px; }
  .handy summary::-webkit-details-marker { display: none; }
  .handy .flyout { position: absolute; top: calc(100% + 10px); right: 0; z-index: 6; width: min(86vw, 280px); display: grid; background: var(--bg); border: 1px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .handy .flyout a { padding: 14px 16px; font-weight: 800; font-size: 1.25rem; text-decoration: none; border-bottom: 1px solid var(--ink); }
  .handy .flyout a:last-child { border-bottom: 0; }
  .handy .flyout a:hover, .handy .flyout a[aria-current] { background: var(--accent); color: var(--ink); }
  @media (max-width: 760px) { .kopf-in { gap: 1rem; } .menue { display: none; } .kopf .knopf { margin-left: auto; } .handy { display: block; } }

  .fuss { padding-top: clamp(3rem, 6vw, 5rem); overflow: hidden; border-top: 6px solid var(--accent); }
  .fuss-in { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 3rem; }
  .fuss nav { display: grid; align-content: start; gap: 0.35rem; }
  .fuss nav p { color: var(--accent); margin-bottom: 0.4rem; }
  .fuss nav a { text-decoration: none; font-size: 1.05rem; }
  .fuss nav a:hover { color: var(--accent); }
  .fuss-info { grid-column: 1 / -1; max-width: 90ch; padding-top: 1.5rem; border-top: 1px solid var(--dunkel-linie); font-size: 0.85rem; color: var(--dunkel-muted); }
  /* Riesige Wortmarke als Abschluss, bündig an der Unterkante */
  .fuss-marke { margin: clamp(2rem, 5vw, 4rem) 0 0; font-size: clamp(5rem, 22.5vw, 21rem); line-height: 0.72; letter-spacing: -0.03em; margin-left: calc(var(--rand) - 0.04em); color: var(--accent); white-space: nowrap; transform: translateY(0.06em); }
  @media (max-width: 760px) { .fuss-in { grid-template-columns: 1fr 1fr; } }
</style>
