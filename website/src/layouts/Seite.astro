---
// Rahmen der Seite: Kopf, Fuß, Meta-Tags und die Skripte, die mehrere Abschnitte nutzen (Kopieren, Handy-Menü)
import '@fontsource-variable/inter'
import '../styles/basis.css'
import { FUSS, REPO, SEITEN, base } from '../lib/seite'

interface Props { titel?: string; beschreibung?: string }
const {
  titel = 'Deckwerk – Präsentationen aus einem Satz',
  beschreibung = 'Sag in einem Satz, was du zeigen willst: Deckwerk schreibt die Geschichte, gestaltet die Folien, prüft jede einzelne und liefert eine PowerPoint, die du weiterbearbeiten kannst. Kostenlos für Mac und Linux.',
} = Astro.props
const url = new URL(Astro.url.pathname, Astro.site)
const aktiv = (pfad: string) => Astro.url.pathname.endsWith(`/${pfad}`)
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={url} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(`${base}og.jpg`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt</a>
    <header class="kopf">
      <div class="wrap kopf-in">
        <a class="marke" href={base} aria-label="Deckwerk, zum Seitenanfang">
          <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
          <span>Deckwerk</span>
        </a>
        <nav class="menue" aria-label="Hauptmenü">
          {SEITEN.map(([pfad, label]) => <a href={`${base}${pfad}`} aria-current={aktiv(pfad) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="knopf klein" href={`${base}laden/`}>Kostenlos laden</a>
        <details class="handy">
          <summary aria-label="Menü öffnen">Menü</summary>
          <nav class="flyout" aria-label="Menü">
            {SEITEN.map(([pfad, label]) => <a href={`${base}${pfad}`} aria-current={aktiv(pfad) ? 'page' : undefined}>{label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss">
      <div class="wrap fuss-in">
        <div>
          <a class="marke" href={base}>
            <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
            <span>Deckwerk</span>
          </a>
          <p>Präsentationen aus einem Satz. Kostenlos und Open Source.</p>
        </div>
        {
          FUSS.map((m) => (
            <nav aria-label={m.name}>
              <p>{m.name}</p>
              {m.links.map(([href, label]) => (
                <a href={href}>{label}</a>
              ))}
            </nav>
          ))
        }
        <p class="klein">
          Schriften unter der SIL Open Font License. Fotos in den Beispielen von Unsplash (<a href={`${REPO}/blob/master/examples/assets/CREDITS.md`}>Bildnachweise</a>).
          Diese Seite setzt keine Cookies, zählt keine Besucher und lädt nichts von Dritten.
        </p>
      </div>
    </footer>

    <script>
      // Kopieren-Knöpfe
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]'))
        b.addEventListener('click', async () => {
          const alt = b.textContent
          try {
            await navigator.clipboard.writeText(b.dataset.copy!)
            b.textContent = 'Kopiert'
          } catch {
            b.textContent = 'Bitte von Hand kopieren'
          }
          setTimeout(() => (b.textContent = alt), 1600)
        })

      // Apple-artiges Einblenden beim Scrollen; .bewegt startet Mini-Animationen nur, solange sie im Bild sind.
      // Klassen setzt erst das Skript: ohne JS ist alles sofort sichtbar.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ziele = document.querySelectorAll<HTMLElement>('.kopf-mitte, .schritte li, .kachel, .formate figure, .plattform, .spieler, .looks, .faq, .weg')
        const zeigen = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('da'), zeigen.unobserve(e.target))), { rootMargin: '0px 0px -10% 0px' })
        ziele.forEach((el) => {
          const geschwister = [...el.parentElement!.children].filter((x) => x.matches('.schritte li, .kachel, .formate figure, .plattform, .weg'))
          el.style.transitionDelay = `${Math.max(0, geschwister.indexOf(el)) * 90}ms` // Kacheln einer Reihe nacheinander
          el.classList.add('zeigen')
          zeigen.observe(el)
        })
      }
      const bewegt = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('bewegt', e.isIntersecting)))
      document.querySelectorAll('.schritte li').forEach((el) => bewegt.observe(el))

      // Handy-Menü: schließen bei Klick daneben, auf einen Link oder mit Esc
      const menue = document.querySelector<HTMLDetailsElement>('details.handy')!
      document.addEventListener('click', (e) => {
        const t = e.target as Element
        if (menue.open && (!menue.contains(t) || t.closest('a'))) menue.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menue.open) (menue.open = false), menue.querySelector('summary')!.focus()
      })
    </script>
  </body>
</html>

<style is:global>
  .kopf { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px); border-bottom: 1px solid color-mix(in srgb, var(--linie) 60%, transparent); }
  .kopf-in { display: flex; align-items: center; gap: 1.5rem; height: 52px; }
  .marke { display: inline-flex; align-items: center; gap: 8px; color: var(--text); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.02em; }
  .marke:hover { color: var(--text); text-decoration: none; }
  .menue { display: flex; gap: 2rem; margin-left: auto; }
  .menue a { font-size: 0.8rem; color: var(--text); opacity: 0.8; }
  .menue a:hover, .menue a[aria-current] { opacity: 1; text-decoration: none; }
  .menue a[aria-current] { font-weight: 600; }
  .handy { display: none; position: relative; }
  .handy summary { list-style: none; cursor: pointer; padding: 6px 10px; font-size: 0.85rem; color: var(--text); }
  .handy summary::-webkit-details-marker { display: none; }
  .handy .flyout { position: absolute; top: calc(100% + 10px); right: 0; z-index: 6; width: min(80vw, 240px); padding: 8px; display: grid; background: var(--kachel); border-radius: 14px; box-shadow: var(--schatten); }
  .handy .flyout a { padding: 10px 12px; border-radius: 8px; color: var(--text); font-weight: 500; }
  .handy .flyout a:hover { background: var(--grau); text-decoration: none; }
  @media (max-width: 760px) { .menue { display: none; } .kopf .knopf { margin-left: auto; } .handy { display: block; } }

  .fuss { background: var(--bg); border-top: 1px solid var(--linie); padding-block: 2.5rem 3rem; color: var(--muted); font-size: 0.78rem; line-height: 1.6; }
  .fuss-in { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem 3rem; }
  .fuss-in > * { min-width: 0; }
  .fuss .marke { font-size: 0.9rem; }
  .fuss-in p { margin-top: 0.5rem; }
  .fuss nav { display: grid; align-content: start; gap: 0.3rem; }
  .fuss nav p { margin: 0 0 0.2rem; font-weight: 600; color: var(--text); }
  .fuss nav a { color: var(--muted); }
  .fuss nav a:hover { color: var(--text); }
  .fuss .klein { grid-column: 1 / -1; max-width: 90ch; padding-top: 1.25rem; border-top: 1px solid var(--linie); font-size: 0.75rem; }
  @media (max-width: 760px) { .fuss-in { grid-template-columns: 1fr 1fr; } .fuss-in > div:first-child { grid-column: 1 / -1; } }
</style>
