import { ListView } from "std-widgets.slint";

export struct Thumb {
    image: image,
    label: string,
}

// Rechteck in Folienpixeln
export struct SRect {
    x: float,
    y: float,
    w: float,
    h: float,
}

export component AppWindow inherits Window {
    in property <string> win-title: "Deckwerk-Spike";
    title: win-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #e9e9e6;

    in property <[Thumb]> thumbs;
    in property <int> current;
    in property <image> stage-image;
    in property <string> placeholder;
    in property <string> status;
    in property <float> slide-w: 1280;
    in property <float> slide-h: 720;
    // Auswahl in Folienpixeln; die Stage rechnet in Bildschirm um
    in property <bool> sel-visible;
    in property <float> sel-x;
    in property <float> sel-y;
    in property <float> sel-w;
    in property <float> sel-h;
    // Editor-Overlay aus dw-edit: Cursor, Auswahl, Preedit-Unterstreichung (Folienpixel)
    in property <bool> editing;
    in property <bool> caret-visible;
    in property <SRect> caret;
    in property <[SRect]> sel-rects;
    in property <[SRect]> compose-rects;
    // Folie → Bildschirm (logische px), für die Texturauflösung
    out property <float> stage-f: stage.f;

    callback stage-pointer(int, float, float, float, float, bool);
    callback select-slide(int);
    callback nav(int);
    callback deselect();
    callback start-edit();
    callback save();
    callback undo(bool);
    callback edit-key(string, bool, bool, bool) -> bool;

    public function focus-editor() {
        edit-keys.focus();
    }
    public function focus-keys() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && (e.text == "s" || e.text == "S")) {
                root.save();
                return accept;
            }
            if (e.modifiers.control && (e.text == "z" || e.text == "Z")) {
                root.undo(e.modifiers.shift);
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                root.nav(-1);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.nav(1);
                return accept;
            }
            if (e.text == Key.Escape) {
                root.deselect();
                return accept;
            }
            if (e.text == Key.Return) {
                root.start-edit();
                return accept;
            }
            reject
        }

        // Tasten beim Bearbeiten gehen an dw-edit; IME kommt über winit direkt (main.rs)
        edit-keys := FocusScope {
            width: 0px;
            height: 0px;
            enabled: root.editing;
            key-pressed(e) => {
                if (root.edit-key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) {
                    return accept;
                }
                reject
            }
        }

        VerticalLayout {
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                ListView {
                    width: 200px;
                    for t[i] in root.thumbs: Rectangle {
                        height: 120px;
                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            border-width: i == root.current ? 3px : 1px;
                            border-color: i == root.current ? #2f6fd6 : #b8b8b2;
                            background: white;
                            Image {
                                x: 3px;
                                y: 3px;
                                width: parent.width - 6px;
                                height: parent.height - 6px;
                                source: t.image;
                                image-fit: contain;
                            }
                            if t.label != "": Text {
                                text: t.label;
                                color: #444;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.select-slide(i);
                            }
                        }
                    }
                }

                stage := Rectangle {
                    property <float> f: min(self.width / 1px / root.slide-w, self.height / 1px / root.slide-h);
                    property <length> ox: (self.width - root.slide-w * f * 1px) / 2;
                    property <length> oy: (self.height - root.slide-h * f * 1px) / 2;
                    Image {
                        x: stage.ox;
                        y: stage.oy;
                        width: root.slide-w * stage.f * 1px;
                        height: root.slide-h * stage.f * 1px;
                        source: root.stage-image;
                    }
                    if root.placeholder != "": Text {
                        text: root.placeholder;
                        font-size: 22px;
                        color: #555;
                    }
                    if root.sel-visible: Rectangle {
                        x: stage.ox + root.sel-x * stage.f * 1px - 2px;
                        y: stage.oy + root.sel-y * stage.f * 1px - 2px;
                        width: root.sel-w * stage.f * 1px + 4px;
                        height: root.sel-h * stage.f * 1px + 4px;
                        border-width: root.editing ? 1px : 2px;
                        border-color: #2f6fd6;
                    }
                    for r in root.sel-rects: Rectangle {
                        x: stage.ox + r.x * stage.f * 1px;
                        y: stage.oy + r.y * stage.f * 1px;
                        width: r.w * stage.f * 1px;
                        height: r.h * stage.f * 1px;
                        background: #2f6fd650;
                    }
                    for r in root.compose-rects: Rectangle {
                        x: stage.ox + r.x * stage.f * 1px;
                        y: stage.oy + (r.y + r.h) * stage.f * 1px - 2px;
                        width: r.w * stage.f * 1px;
                        height: 2px;
                        background: #2f6fd6;
                    }
                    if root.editing && root.caret-visible: Rectangle {
                        x: stage.ox + root.caret.x * stage.f * 1px;
                        y: stage.oy + root.caret.y * stage.f * 1px;
                        width: max(1px, root.caret.w * stage.f * 1px);
                        height: root.caret.h * stage.f * 1px;
                        background: #1a1a1a;
                    }
                    // Zeiger in Rust gegen Measured-Boxen bzw. das Editor-Layout prüfen (dw_edit::stage)
                    TouchArea {
                        pointer-event(e) => {
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                                root.stage-pointer(0, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, e.modifiers.shift);
                            }
                            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                                root.stage-pointer(2, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, e.modifiers.shift);
                            }
                        }
                        moved => {
                            root.stage-pointer(1, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, false);
                        }
                        double-clicked => {
                            root.stage-pointer(3, self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, false);
                        }
                    }
                }
            }

            Rectangle {
                height: 28px;
                background: #d9d9d4;
                Text {
                    x: 12px;
                    text: root.status;
                    color: #222;
                    vertical-alignment: center;
                }
            }
        }
    }
}
